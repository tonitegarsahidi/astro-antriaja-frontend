---
interface Props {
  title?: string;
  tenantName?: string;
}

const {
  title = 'Layar Display TV - AntriAja',
  tenantName = 'AntriAja Smart Queue',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#090d16" />
  </head>
  <body class="display-body">
    <div class="display-layout">
      <!-- Top Header Bar -->
      <header class="display-header">
        <div class="header-brand">
          <div class="brand-logo-badge" id="display-brand-logo-badge">
            <img
              id="display-tenant-logo-img"
              src=""
              alt="Logo Instansi"
              class="brand-logo-image hidden"
              onerror="this.classList.add('hidden'); document.getElementById('display-default-logo-icon')?.classList.remove('hidden');"
            />
            <svg id="display-default-logo-icon" class="w-8 h-8 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
          </div>
          <div>
            <h1 class="tenant-title" id="display-tenant-name">{tenantName}</h1>
            <p class="tenant-sub">SISTEM MANAJEMEN ANTRIAN TERPADU</p>
          </div>
        </div>

        <div class="header-status-area">
          <div class="sse-badge" id="sse-status-badge">
            <span class="status-indicator-dot" id="sse-indicator-dot"></span>
            <span id="sse-status-text">Menyambungkan...</span>
          </div>

          <div class="clock-box">
            <span class="clock-time" id="digital-clock">00:00:00</span>
            <span class="clock-date" id="digital-date">Memuat tanggal...</span>
          </div>
        </div>
      </header>

      <!-- Main Split Screen Workspace -->
      <main class="display-main" id="display-main-content">
        <slot />
      </main>
    </div>

    <script>
      // Update digital clock every second
      function updateClock() {
        const now = new Date();
        const timeEl = document.getElementById('digital-clock');
        const dateEl = document.getElementById('digital-date');

        if (timeEl) {
          timeEl.textContent = now.toLocaleTimeString('id-ID', {
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false,
          });
        }

        if (dateEl) {
          dateEl.textContent = now.toLocaleDateString('id-ID', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          });
        }
      }

      updateClock();
      setInterval(updateClock, 1000);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg-display: #070a12;
    --card-display: #0f172a;
    --border-display: #1e293b;
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --accent-blue: #38bdf8;
    --accent-glow: rgba(56, 189, 248, 0.35);
    --accent-green: #22c55e;
    --accent-gold: #f59e0b;
    --danger-color: #ef4444;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    user-select: none;
    -webkit-user-select: none;
  }

  body.display-body {
    background-color: var(--bg-display);
    color: var(--text-primary);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    overflow: hidden;
    width: 100vw;
    height: 100vh;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  body.display-body.theme-light {
    --bg-display: #f1f5f9;
    --card-display: #ffffff;
    --border-display: #cbd5e1;
    --text-primary: #0f172a;
    --text-secondary: #475569;
    --accent-blue: #0284c7;
    --accent-glow: rgba(2, 132, 199, 0.25);
  }

  .display-layout {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
  }

  .display-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(180deg, #0f172a 0%, #090d16 100%);
    border-bottom: 2px solid var(--border-display);
    padding: 1rem 2.5rem;
    height: 5.5rem;
    flex-shrink: 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .brand-logo-badge {
    width: 3.25rem;
    height: 3.25rem;
    background: rgba(56, 189, 248, 0.1);
    border: 2px solid rgba(56, 189, 248, 0.3);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0.25rem;
  }

  .brand-logo-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .hidden {
    display: none !important;
  }

  .tenant-title {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .tenant-sub {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--accent-blue);
  }

  .header-status-area {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .sse-badge {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 1rem;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid var(--border-display);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .status-indicator-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background-color: var(--accent-gold);
    box-shadow: 0 0 8px var(--accent-gold);
  }

  .sse-badge.connected .status-indicator-dot {
    background-color: var(--accent-green);
    box-shadow: 0 0 10px var(--accent-green);
  }

  .sse-badge.disconnected .status-indicator-dot {
    background-color: var(--danger-color);
    box-shadow: 0 0 10px var(--danger-color);
  }

  .clock-box {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .clock-time {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
    letter-spacing: 0.05em;
  }

  .clock-date {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }

  .display-main {
    flex: 1;
    overflow: hidden;
    position: relative;
  }
</style>
