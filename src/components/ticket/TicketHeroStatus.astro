---
import type { TicketStatus } from '../../types/queue.types';

interface Props {
  ticketNumber: string;
  status: TicketStatus;
  serviceName: string;
  isVip?: boolean;
}

const { ticketNumber, status, serviceName, isVip = false } = Astro.props;

const statusLabels: Record<TicketStatus, { label: string; class: string }> = {
  waiting: { label: 'Menunggu Giliran', class: 'status-waiting' },
  called: { label: 'Sedang Dipanggil!', class: 'status-called' },
  serving: { label: 'Sedang Dilayani', class: 'status-serving' },
  hold: { label: 'Ditunda', class: 'status-hold' },
  transferred: { label: 'Dialihkan', class: 'status-transferred' },
  completed: { label: 'Selesai', class: 'status-completed' },
  expired: { label: 'Kedaluwarsa', class: 'status-expired' },
};

const currentStatus = statusLabels[status] || { label: status, class: 'status-waiting' };
---

<div class="ticket-hero-card">
  <div class="ticket-header">
    <span class="service-name" id="ticket-service-name">{serviceName}</span>
    {isVip && <span class="badge-vip" id="ticket-vip-badge">⭐ VIP</span>}
  </div>

  <div class="ticket-number-display" id="ticket-number">{ticketNumber}</div>

  <div class={`status-badge ${currentStatus.class}`} id="ticket-status-badge">
    {currentStatus.label}
  </div>
</div>

<style>
  .ticket-hero-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem 1.5rem;
    text-align: center;
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    position: relative;
    overflow: hidden;
  }

  .ticket-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .service-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-vip {
    background: #fef08a;
    color: #854d0e;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid #fde047;
  }

  .ticket-number-display {
    font-size: 4rem;
    font-weight: 900;
    color: var(--color-primary);
    letter-spacing: -0.025em;
    line-height: 1;
    margin: 0.5rem 0;
  }

  .status-badge {
    display: inline-block;
    padding: 0.4rem 1.25rem;
    border-radius: var(--radius-full);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .status-waiting {
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fde68a;
  }

  .status-called {
    background: #dbeafe;
    color: #1e40af;
    border: 1px solid #bfdbfe;
    animation: pulse 1.5s infinite;
  }

  .status-serving {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .status-hold {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
  }

  .status-transferred {
    background: #f3e8ff;
    color: #6b21a8;
    border: 1px solid #e9d5ff;
  }

  .status-completed {
    background: #d1fae5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .status-expired {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.85;
      transform: scale(1.03);
    }
  }
</style>
