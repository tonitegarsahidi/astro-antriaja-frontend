---
---

<div class="audio-unlock-overlay" id="audio-unlock-overlay">
  <div class="unlock-card">
    <div class="unlock-icon-pulse">
      <svg class="w-12 h-12 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
      </svg>
    </div>
    <h2 class="unlock-title">Aktifkan Suara & Layar Penuh</h2>
    <p class="unlock-desc">
      Kebijakan keamanan browser memerlukan 1 kali interaksi klik untuk mengizinkan pemanggilan suara antrian otomatis dan mode fullscreen.
    </p>
    <button type="button" class="btn-unlock-audio" id="btn-unlock-audio">
      <span>KLIK DI MANA SAJA UNTUK MEMULAI</span>
    </button>
  </div>
</div>

<style>
  .audio-unlock-overlay {
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(3, 7, 18, 0.88);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    cursor: pointer;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .audio-unlock-overlay.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .unlock-card {
    background: #0f172a;
    border: 2px solid rgba(56, 189, 248, 0.4);
    border-radius: 2rem;
    padding: 3rem;
    max-width: 580px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8), 0 0 50px rgba(56, 189, 248, 0.3);
    animation: bounceIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes bounceIn {
    0% { transform: scale(0.9); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .unlock-icon-pulse {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 1.5rem;
    background: rgba(56, 189, 248, 0.15);
    border: 2px solid rgba(56, 189, 248, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: iconPulse 1.5s infinite alternate;
  }

  @keyframes iconPulse {
    0% { transform: scale(1); box-shadow: 0 0 20px rgba(56, 189, 248, 0.3); }
    100% { transform: scale(1.08); box-shadow: 0 0 40px rgba(56, 189, 248, 0.7); }
  }

  .unlock-title {
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .unlock-desc {
    font-size: 1.05rem;
    color: #94a3b8;
    line-height: 1.6;
  }

  .btn-unlock-audio {
    margin-top: 0.5rem;
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    border: none;
    padding: 1.25rem 2.5rem;
    border-radius: 1rem;
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    cursor: pointer;
    box-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.5);
    transition: all 0.2s ease;
  }

  .btn-unlock-audio:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px rgba(2, 132, 199, 0.7);
  }
</style>
