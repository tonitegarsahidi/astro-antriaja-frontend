---
import type { RecentCallItem } from '../../types/display.types';

interface Props {
  recentCalls?: RecentCallItem[];
}

const { recentCalls = [] } = Astro.props;
---

<div class="recent-calls-wrapper">
  <div class="recent-header">
    <div class="recent-indicator"></div>
    <h3 class="recent-title">RIWAYAT PANGGILAN TERAKHIR</h3>
  </div>

  <div class="recent-list-container" id="recent-calls-container">
    {recentCalls.length === 0 ? (
      <div class="recent-empty-state">
        <p>Belum ada riwayat panggilan</p>
      </div>
    ) : (
      recentCalls.slice(0, 4).map((call) => (
        <div class="recent-call-item">
          <span class="recent-ticket-num">{call.ticket_number}</span>
          <div class="recent-dest-info">
            <span class="recent-counter-label">{call.counter_name || `Loket ${call.counter_number}`}</span>
            <span class="recent-service-label">{call.service_name}</span>
          </div>
        </div>
      ))
    )}
  </div>
</div>

<style>
  .recent-calls-wrapper {
    background: rgba(15, 23, 42, 0.65);
    border: 2px solid var(--border-display);
    border-radius: 1.25rem;
    padding: 1.25rem 1.75rem;
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .recent-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .recent-indicator {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--accent-blue);
  }

  .recent-title {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
  }

  .recent-list-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  .recent-empty-state {
    grid-column: 1 / -1;
    padding: 1rem;
    text-align: center;
    color: #64748b;
    font-size: 0.95rem;
    font-style: italic;
  }

  .recent-call-item {
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.875rem;
    padding: 0.875rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: transform 0.2s ease;
  }

  .recent-ticket-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 1.75rem;
    font-weight: 800;
    color: #e2e8f0;
    letter-spacing: -0.01em;
  }

  .recent-dest-info {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .recent-counter-label {
    font-size: 1rem;
    font-weight: 700;
    color: #38bdf8;
  }

  .recent-service-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: #94a3b8;
    max-width: 110px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
