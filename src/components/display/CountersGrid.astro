---
---

<div class="counters-grid-wrapper">
  <div class="counters-header">
    <div class="counters-title-row">
      <svg class="w-5 h-5 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
      <h3 class="counters-title">STATUS LOKET</h3>
    </div>
    <span class="counters-hint">DILAYANI SAAT INI</span>
  </div>

  <div class="counters-grid" id="counters-grid">
    <!-- Diisi secara dinamis via JavaScript dari snapshot & realtime events -->
    <div class="counter-placeholder-loading">
      <span>Memuat data loket...</span>
    </div>
  </div>
</div>

<style>
  .counters-grid-wrapper {
    background: rgba(15, 23, 42, 0.7);
    border: 2px solid var(--border-display);
    border-radius: 1.25rem;
    padding: 1.25rem 1.5rem;
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    flex: 1;
    overflow: hidden;
  }

  .counters-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.75rem;
  }

  .counters-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .counters-title {
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #f1f5f9;
  }

  .counters-hint {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent-blue);
  }

  .counters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(135px, 1fr));
    gap: 0.75rem;
    overflow-y: auto;
    max-height: 100%;
    padding-right: 0.25rem;
  }

  .counter-placeholder-loading {
    grid-column: 1 / -1;
    text-align: center;
    padding: 1.5rem;
    color: #64748b;
    font-size: 0.875rem;
    font-style: italic;
  }
</style>
