---
import type { MediaType } from '../../types/display.types';

interface Props {
  mediaType?: MediaType;
  mediaUrl?: string | null;
  tenantName?: string;
}

const {
  mediaType = 'none',
  mediaUrl = null,
  tenantName = 'AntriAja Smart Queue',
} = Astro.props;

const hasVideo = mediaType === 'video' && Boolean(mediaUrl);
const hasImage = mediaType === 'image' && Boolean(mediaUrl);
---

<div class="media-promo-box" id="media-promo-container">
  {hasVideo && (
    <video
      class="media-element media-video"
      src={mediaUrl!}
      autoplay
      loop
      muted
      playsinline
      id="promo-video-player"
    ></video>
  )}

  {hasImage && (
    <img
      class="media-element media-image"
      src={mediaUrl!}
      alt={`Promosi ${tenantName}`}
      id="promo-image-viewer"
    />
  )}

  {!hasVideo && !hasImage && (
    <div class="media-placeholder" id="promo-default-placeholder">
      <div class="placeholder-content">
        <div class="placeholder-icon">
          <svg class="w-16 h-16 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <h3 class="placeholder-title">{tenantName}</h3>
        <p class="placeholder-badge">AntriAja Smart Queue</p>
        <p class="placeholder-sub">Silakan menunggu dengan nyaman hingga nomor antrian Anda dipanggil petugas.</p>
      </div>
    </div>
  )}
</div>

<style>
  .media-promo-box {
    width: 100%;
    height: 100%;
    border-radius: 1.5rem;
    overflow: hidden;
    position: relative;
    background: #020617;
    border: 2px solid var(--border-display);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .media-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem;
    text-align: center;
    background: radial-gradient(circle at center, #1e293b 0%, #090d16 100%);
  }

  .placeholder-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 85%;
  }

  .placeholder-icon {
    width: 5rem;
    height: 5rem;
    border-radius: 1.25rem;
    background: rgba(56, 189, 248, 0.1);
    border: 2px solid rgba(56, 189, 248, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .placeholder-badge {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-blue);
    background: rgba(56, 189, 248, 0.12);
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .placeholder-sub {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
