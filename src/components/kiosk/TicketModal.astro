---
interface Props {
  isOpen?: boolean;
}

const { isOpen = false } = Astro.props;
---

<div
  class={`ticket-modal-backdrop ${isOpen ? 'is-open' : 'is-hidden'}`}
  id="ticket-modal-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ticket-success-title"
>
  <div class="ticket-receipt-card">
    <header class="receipt-header">
      <span class="success-check-icon">✅</span>
      <h2 id="ticket-success-title">TIKET BERHASIL DITERBITKAN</h2>
      <p class="service-selected-label" id="modal-service-name">Memuat layanan...</p>
    </header>

    <div class="ticket-number-box">
      <span class="ticket-number-label">Nomor Antrian Anda</span>
      <div class="ticket-huge-number" id="modal-ticket-number">---</div>
      <div class="vip-badge-ribbon is-hidden" id="modal-vip-badge">⭐ JALUR PRIORITAS</div>
    </div>

    <!-- QR Code SVG Container untuk Mobile Tracking -->
    <div class="qr-code-wrapper">
      <div class="qr-code-box" id="qr-code-canvas"></div>
      <span class="qr-instruction">Scan QR dengan kamera ponsel untuk memantau panggilan antrian secara mobile.</span>
    </div>

    <!-- Action Buttons & Auto-Close Timer -->
    <div class="receipt-actions">
      <button type="button" class="btn-print" id="btn-print-receipt">
        🖨️ Cetak Struk Fisik
      </button>
      <button type="button" class="btn-done" id="btn-close-ticket-modal">
        Selesai (<span id="countdown-timer">8</span>s)
      </button>
    </div>
  </div>
</div>

<style>
  .ticket-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 1.5rem;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .ticket-modal-backdrop.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .ticket-modal-backdrop.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .ticket-receipt-card {
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    padding: 2.5rem 2rem;
    max-width: 480px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
    text-align: center;
    animation: scaleUp 0.3s ease;
  }

  .receipt-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .success-check-icon {
    font-size: 2.5rem;
  }

  .receipt-header h2 {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--color-success);
    letter-spacing: 0.05em;
  }

  .service-selected-label {
    font-size: 1rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .ticket-number-box {
    background: #eff6ff;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-lg);
    padding: 1.25rem 2rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .ticket-number-label {
    font-size: 0.85rem;
    color: var(--color-primary);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ticket-huge-number {
    font-size: 4.5rem;
    font-weight: 900;
    color: var(--color-text);
    line-height: 1;
    margin: 0.25rem 0;
  }

  .vip-badge-ribbon {
    background: #fef08a;
    color: #854d0e;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid #fde047;
  }

  .vip-badge-ribbon.is-hidden {
    display: none;
  }

  .qr-code-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .qr-code-box {
    background: #ffffff;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qr-instruction {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    max-width: 320px;
    line-height: 1.4;
  }

  .receipt-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .btn-print,
  .btn-done {
    padding: 0.9rem 1.5rem;
    border-radius: var(--radius-md);
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease;
  }

  .btn-print {
    background: #f1f5f9;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-print:hover {
    background: #e2e8f0;
  }

  .btn-done {
    background: var(--color-primary);
    color: #ffffff;
  }

  .btn-done:hover {
    background: var(--color-primary-hover);
  }

  @keyframes scaleUp {
    0% {
      opacity: 0;
      transform: scale(0.92);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
