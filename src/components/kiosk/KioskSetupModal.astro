---
interface Props {
  isOpen?: boolean;
}

const { isOpen = false } = Astro.props;
---

<div
  class={`setup-modal-backdrop ${isOpen ? 'is-open' : 'is-hidden'}`}
  id="kiosk-setup-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="setup-modal-title"
>
  <div class="setup-modal-card">
    <header class="setup-header">
      <span class="setup-icon">⚙️</span>
      <h2 id="setup-modal-title">Konfigurasi Kiosk</h2>
      <p>Lakukan pairing perangkat Kiosk dengan memasukkan Tenant Slug dan Kiosk Key.</p>
    </header>

    <form id="form-kiosk-setup" class="setup-form">
      <div class="form-group">
        <label for="input-kiosk-slug">Tenant Slug:</label>
        <input
          type="text"
          id="input-kiosk-slug"
          placeholder="Contoh: demo-bank"
          required
          autocomplete="off"
        />
      </div>

      <div class="form-group">
        <label for="input-kiosk-key">Kiosk Device Key:</label>
        <input
          type="text"
          id="input-kiosk-key"
          placeholder="Contoh: kiosk-demo-key-123"
          required
          autocomplete="off"
        />
      </div>

      <button type="submit" class="btn-save-setup" id="btn-save-kiosk-setup">
        Simpan & Mulai Kiosk
      </button>
    </form>
  </div>
</div>

<style>
  .setup-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    padding: 1.5rem;
  }

  .setup-modal-backdrop.is-hidden {
    display: none !important;
  }

  .setup-modal-backdrop.is-open {
    display: flex !important;
  }

  .setup-modal-card {
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    padding: 2.5rem 2rem;
    max-width: 460px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
    border: 1px solid var(--color-border);
  }

  .setup-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .setup-icon {
    font-size: 2.5rem;
  }

  .setup-header h2 {
    font-size: 1.5rem;
    font-weight: 800;
  }

  .setup-header p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .setup-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .form-group input {
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 1rem;
    outline: none;
  }

  .form-group input:focus {
    border-color: var(--color-primary);
  }

  .btn-save-setup {
    background: var(--color-primary);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.9rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    margin-top: 0.5rem;
    transition: background 0.15s ease;
  }

  .btn-save-setup:hover {
    background: var(--color-primary-hover);
  }
</style>
