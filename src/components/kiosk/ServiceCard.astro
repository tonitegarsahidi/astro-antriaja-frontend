---
interface Props {
  id: string;
  name: string;
  prefix: string;
  estimatedDurationMins: number;
  waitingCount: number;
}

const { id, name, prefix, estimatedDurationMins, waitingCount } = Astro.props;
---

<button
  type="button"
  class="kiosk-service-btn"
  data-service-id={id}
  data-service-name={name}
  data-service-prefix={prefix}
>
  <div class="service-prefix-badge">{prefix}</div>
  <div class="service-body">
    <h3 class="service-title">{name}</h3>
    <span class="service-duration">Estimasi: ~{estimatedDurationMins} mnt</span>
  </div>
  <div class="service-waiting-badge">
    <span class="waiting-label">Menunggu:</span>
    <strong class="waiting-number" data-waiting-for={id}>{waitingCount}</strong>
    <span class="waiting-unit">Orang</span>
  </div>
</button>

<style>
  .kiosk-service-btn {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05);
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    min-height: 250px;
    justify-content: space-between;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .kiosk-service-btn:hover,
  .kiosk-service-btn:focus-visible {
    transform: translateY(-4px);
    border-color: var(--color-primary);
    box-shadow: 0 10px 15px -3px rgb(37 99 235 / 0.2);
  }

  .kiosk-service-btn:active {
    transform: scale(0.97);
    background: #eff6ff;
  }

  .kiosk-service-btn.is-disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .service-prefix-badge {
    background: var(--color-primary);
    color: #ffffff;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.25rem;
    font-weight: 900;
    box-shadow: 0 4px 6px -1px rgb(37 99 235 / 0.3);
  }

  .service-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .service-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.3;
  }

  .service-duration {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .service-waiting-badge {
    background: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.4rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .waiting-number {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-primary);
  }
</style>
