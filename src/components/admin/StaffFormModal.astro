---
/**
 * Modal Form Tambah / Edit Akun Staf Petugas AntriAja
 */
---

<div
  id="staff-form-modal"
  class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-staff-title"
>
  <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden transform transition-all">
    <!-- Header -->
    <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center font-bold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <div>
          <h3 id="modal-staff-title" class="text-base font-bold text-slate-900">
            Tambah Staf Baru
          </h3>
          <p id="modal-staff-subtitle" class="text-xs text-slate-500">
            Kelola data akun petugas loket pelayanan
          </p>
        </div>
      </div>
      <button
        id="btn-close-staff-modal"
        type="button"
        class="text-slate-400 hover:text-slate-600 rounded-lg p-1.5 hover:bg-slate-100 transition-colors cursor-pointer"
      >
        <span class="sr-only">Tutup</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Form Content -->
    <form id="staff-form" class="p-6 space-y-4">
      <input type="hidden" id="staff-id-hidden" value="" />

      <!-- Error Alert Box -->
      <div id="staff-modal-error" class="hidden p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium">
      </div>

      <!-- Nama Lengkap -->
      <div>
        <label for="input-staff-name" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
          Nama Lengkap Petugas <span class="text-rose-500">*</span>
        </label>
        <input
          id="input-staff-name"
          name="full_name"
          type="text"
          required
          placeholder="Contoh: Siti Rahmawati / Budi Santoso"
          class="w-full px-3.5 py-2 text-sm rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
        />
      </div>

      <!-- Email -->
      <div>
        <label for="input-staff-email" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
          Alamat Email <span class="text-rose-500">*</span>
        </label>
        <input
          id="input-staff-email"
          name="email"
          type="email"
          required
          placeholder="Contoh: teller1@bank.com"
          class="w-full px-3.5 py-2 text-sm rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
        />
        <p class="text-[11px] text-slate-400 mt-1">Email digunakan oleh petugas untuk login ke konsol loket.</p>
      </div>

      <!-- Password -->
      <div>
        <label for="input-staff-password" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
          Kata Sandi <span id="staff-password-required-star" class="text-rose-500">*</span>
        </label>
        <input
          id="input-staff-password"
          name="password"
          type="password"
          minlength="8"
          placeholder="Minimal 8 karakter"
          class="w-full px-3.5 py-2 text-sm rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
        />
        <p id="staff-password-hint" class="text-[11px] text-slate-400 mt-1">
          Gunakan minimal 8 karakter untuk keamanan akun.
        </p>
      </div>

      <!-- Status Toggle -->
      <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
        <div>
          <span class="text-xs font-bold text-slate-800 block">Status Akun Aktif</span>
          <span class="text-[11px] text-slate-500 block">Petugas nonaktif tidak dapat login atau menjaga loket</span>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input
            id="toggle-staff-active"
            name="is_active"
            type="checkbox"
            checked
            class="sr-only peer"
          />
          <div class="w-11 h-6 bg-slate-200 peer-focus:outline-hidden peer-focus:ring-2 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
        </label>
      </div>

      <!-- Footer Buttons -->
      <div class="pt-4 flex items-center justify-end space-x-3 border-t border-slate-100">
        <button
          id="btn-staff-cancel"
          type="button"
          class="px-4 py-2 text-xs font-bold text-slate-700 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors cursor-pointer"
        >
          Batal
        </button>
        <button
          id="btn-staff-submit"
          type="submit"
          class="px-5 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm hover:shadow transition-all cursor-pointer flex items-center space-x-1.5"
        >
          <span>Simpan Petugas</span>
        </button>
      </div>
    </form>
  </div>
</div>
