---
/**
 * Modal Form Tambah / Edit Kategori Layanan Antrian
 */
---

<div
  id="service-form-modal"
  class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="service-modal-title"
>
  <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden transform transition-all">
    <!-- Header -->
    <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center font-bold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <div>
          <h3 id="service-modal-title" class="text-base font-bold text-slate-900">
            Kategori Layanan
          </h3>
          <p id="service-modal-subtitle" class="text-xs text-slate-500">
            Kelola konfigurasi layanan dan alokasi antrian
          </p>
        </div>
      </div>
      <button
        id="btn-close-service-modal"
        type="button"
        class="text-slate-400 hover:text-slate-600 rounded-lg p-1.5 hover:bg-slate-100 transition-colors"
      >
        <span class="sr-only">Tutup</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Form Content -->
    <form id="service-form" class="p-6 space-y-4">
      <input type="hidden" id="service-id-hidden" value="" />

      <!-- Service Name -->
      <div>
        <label for="input-service-name" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
          Nama Layanan <span class="text-rose-500">*</span>
        </label>
        <input
          id="input-service-name"
          name="name"
          type="text"
          required
          placeholder="Contoh: Customer Service / Teller"
          class="w-full px-3.5 py-2 text-sm rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
        />
      </div>

      <!-- Prefix & Estimated Duration -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="input-service-prefix" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
            Prefix Kode <span class="text-rose-500">*</span>
          </label>
          <input
            id="input-service-prefix"
            name="prefix"
            type="text"
            required
            maxlength="2"
            placeholder="A - Z (Maks 2)"
            class="w-full px-3.5 py-2 text-sm uppercase font-mono tracking-wider rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
          />
          <p class="text-[11px] text-slate-500 mt-1">1-2 huruf kapital, cth: A atau CS</p>
        </div>

        <div>
          <label for="input-service-duration" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
            Estimasi Durasi (Menit) <span class="text-rose-500">*</span>
          </label>
          <input
            id="input-service-duration"
            name="estimated_duration_mins"
            type="number"
            min="1"
            max="120"
            required
            value="5"
            class="w-full px-3.5 py-2 text-sm rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
          />
          <p class="text-[11px] text-slate-500 mt-1">Digunakan untuk estimasi waktu tunggu</p>
        </div>
      </div>

      <!-- Service Image (Upload or URL) -->
      <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-3">
        <div class="flex items-center justify-between">
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide">
            Gambar Layanan <span class="text-slate-400 font-normal lowercase">(opsional)</span>
          </label>
          <div class="flex items-center space-x-1 text-xs">
            <button
              type="button"
              id="tab-img-upload"
              class="px-2.5 py-1 rounded-md font-semibold text-blue-600 bg-blue-100 hover:bg-blue-200 transition-colors cursor-pointer"
            >
              Upload File
            </button>
            <button
              type="button"
              id="tab-img-url"
              class="px-2.5 py-1 rounded-md font-semibold text-slate-600 hover:bg-slate-200 transition-colors cursor-pointer"
            >
              Input URL
            </button>
          </div>
        </div>

        <!-- File Upload Input Pane -->
        <div id="pane-img-upload" class="space-y-1.5">
          <input
            id="input-service-image-file"
            type="file"
            accept="image/png,image/jpeg,image/webp,image/gif"
            class="block w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer border border-slate-300 rounded-lg p-1 bg-white"
          />
          <p class="text-[11px] text-slate-500">Maks. 5 MB (PNG, JPG, WEBP, GIF)</p>
        </div>

        <!-- URL Input Pane (Hidden by default, or accessible directly) -->
        <div id="pane-img-url" class="space-y-1.5 hidden">
          <input
            id="input-service-image-url"
            name="image_url"
            type="text"
            placeholder="https://contoh.com/icon.png atau /uploads/images/..."
            class="w-full px-3.5 py-2 text-sm rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white"
          />
          <p class="text-[11px] text-slate-500">Masukkan URL lengkap gambar eksternal atau berkas lokal</p>
        </div>

        <!-- Image Preview Box -->
        <div
          id="service-image-preview-box"
          class="hidden flex items-center space-x-3 p-2 bg-white rounded-lg border border-slate-200"
        >
          <img
            id="service-image-preview-img"
            src=""
            alt="Preview Gambar Layanan"
            class="w-12 h-12 object-contain rounded-md border border-slate-100 bg-slate-50"
          />
          <div class="flex-1 min-w-0">
            <p id="service-image-preview-text" class="text-xs font-mono text-slate-600 truncate"></p>
            <span class="text-[10px] text-emerald-600 font-semibold">✓ Gambar Siap Ditampilkan</span>
          </div>
          <button
            type="button"
            id="btn-remove-service-image"
            class="text-xs text-rose-600 hover:text-rose-800 font-semibold px-2 py-1 hover:bg-rose-50 rounded-md transition-colors cursor-pointer"
          >
            Hapus
          </button>
        </div>
      </div>

      <!-- Active Toggle -->
      <div class="flex items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200">
        <div>
          <span class="text-xs font-bold text-slate-800">Status Layanan Aktif</span>
          <p class="text-[11px] text-slate-500">Layanan aktif dapat dipilih pengunjung pada kios tiket</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input
            id="input-service-active"
            name="is_active"
            type="checkbox"
            checked
            class="sr-only peer"
          />
          <div class="w-11 h-6 bg-slate-300 peer-focus:outline-hidden rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
        </label>
      </div>

      <!-- Feedback Error -->
      <div id="service-form-error" class="hidden text-xs font-semibold text-rose-600 bg-rose-50 p-2.5 rounded-lg border border-rose-200"></div>

      <!-- Footer Buttons -->
      <div class="pt-3 border-t border-slate-100 flex items-center justify-end space-x-3">
        <button
          id="btn-cancel-service"
          type="button"
          class="px-4 py-2 text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-100 border border-slate-300 rounded-lg transition-colors cursor-pointer"
        >
          Batal
        </button>
        <button
          id="btn-save-service"
          type="submit"
          class="px-5 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-xs hover:shadow-md transition-all cursor-pointer flex items-center space-x-1.5"
        >
          <span>Simpan Layanan</span>
        </button>
      </div>
    </form>
  </div>
</div>
