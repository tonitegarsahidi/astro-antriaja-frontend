---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sm:p-5 ${className}`}>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 sm:gap-3">
    <!-- 1. Panggil Berikutnya (Call Next) -->
    <button
      id="btn-call-next"
      type="button"
      class="flex flex-col items-center justify-center p-3 sm:py-4 sm:px-3 rounded-xl font-bold text-xs sm:text-sm text-center transition-all focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 bg-emerald-600 hover:bg-emerald-700 text-white shadow-2xs hover:shadow-md disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-emerald-600 disabled:shadow-none cursor-pointer"
      title="Panggil tiket antrian berikutnya sesuai prioritas dan FIFO"
    >
      <svg class="w-5 h-5 sm:w-6 sm:h-6 mb-1.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
      </svg>
      <span class="leading-tight">Panggil Berikutnya</span>
    </button>

    <!-- 2. Panggil Ulang (Recall) -->
    <button
      id="btn-recall"
      type="button"
      disabled
      class="flex flex-col items-center justify-center p-3 sm:py-4 sm:px-3 rounded-xl font-bold text-xs sm:text-sm text-center transition-all focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-blue-50 cursor-pointer"
      title="Panggil kembali nomor tiket yang sedang aktif"
    >
      <svg class="w-5 h-5 sm:w-6 sm:h-6 mb-1.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
      </svg>
      <span class="leading-tight">Panggil Ulang</span>
    </button>

    <!-- 3. Mulai Layani (Start Serving) -->
    <button
      id="btn-serve"
      type="button"
      disabled
      class="flex flex-col items-center justify-center p-3 sm:py-4 sm:px-3 rounded-xl font-bold text-xs sm:text-sm text-center transition-all focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-indigo-50 cursor-pointer"
      title="Mulai melayani pengunjung yang telah hadir di loket"
    >
      <svg class="w-5 h-5 sm:w-6 sm:h-6 mb-1.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="leading-tight">Mulai Layani</span>
    </button>

    <!-- 4. Tunda (Hold) -->
    <button
      id="btn-hold"
      type="button"
      disabled
      class="flex flex-col items-center justify-center p-3 sm:py-4 sm:px-3 rounded-xl font-bold text-xs sm:text-sm text-center transition-all focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-amber-50 cursor-pointer"
      title="Tunda nomor antrian karena pengunjung tidak hadir"
    >
      <svg class="w-5 h-5 sm:w-6 sm:h-6 mb-1.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="leading-tight">Tunda (No-Show)</span>
    </button>

    <!-- 5. Selesai (Complete) -->
    <button
      id="btn-complete"
      type="button"
      disabled
      class="flex flex-col items-center justify-center p-3 sm:py-4 sm:px-3 rounded-xl font-bold text-xs sm:text-sm text-center transition-all focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-emerald-50 cursor-pointer"
      title="Selesaikan pelayanan untuk tiket ini"
    >
      <svg class="w-5 h-5 sm:w-6 sm:h-6 mb-1.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="leading-tight">Selesai</span>
    </button>

    <!-- 6. Oper / Transfer -->
    <button
      id="btn-transfer"
      type="button"
      disabled
      class="flex flex-col items-center justify-center p-3 sm:py-4 sm:px-3 rounded-xl font-bold text-xs sm:text-sm text-center transition-all focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 bg-purple-50 hover:bg-purple-100 text-purple-700 border border-purple-200 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-purple-50 cursor-pointer"
      title="Alihkan pengunjung ke kategori layanan lain"
    >
      <svg class="w-5 h-5 sm:w-6 sm:h-6 mb-1.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
      </svg>
      <span class="leading-tight">Oper / Transfer</span>
    </button>
  </div>
</div>
