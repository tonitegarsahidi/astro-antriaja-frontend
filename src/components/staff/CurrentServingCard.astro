---
import type { TicketResponse } from '../../types/queue.types';
import type { CounterStatus } from '../../types/master.types';

interface Props {
  currentTicket?: TicketResponse | null;
  counterStatus?: CounterStatus;
  serviceName?: string;
}

const { currentTicket, counterStatus = 'idle', serviceName = '' } = Astro.props;
const isServing = currentTicket?.status === 'serving';
const isCalled = currentTicket?.status === 'called';
---

<div class="current-ticket-card bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8 flex flex-col items-center justify-center text-center relative overflow-hidden transition-all">
  <!-- Top Accent Bar -->
  <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-blue-600 via-indigo-600 to-emerald-500"></div>

  {currentTicket ? (
    <div class="w-full flex flex-col items-center space-y-4">
      <!-- Status Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2">
        {currentTicket.is_vip && (
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300 shadow-2xs">
            <svg class="w-3.5 h-3.5 mr-1 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            JALUR PRIORITAS (VIP)
          </span>
        )}

        {isCalled && (
          <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-900 border border-blue-300 shadow-2xs animate-pulse">
            <span class="w-2 h-2 rounded-full bg-blue-600 mr-1.5 animate-ping"></span>
            DIPANGGIL KE LOKET
          </span>
        )}

        {isServing && (
          <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-900 border border-emerald-300 shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-emerald-600 mr-1.5 animate-pulse"></span>
            SEDANG DILAYANI
          </span>
        )}
      </div>

      <!-- Ticket Number Display -->
      <div class="my-1 sm:my-2">
        <span class="text-xs uppercase tracking-widest font-bold text-slate-400 block mb-1">Nomor Antrian Aktif</span>
        <div id="current-ticket-number" class="text-6xl sm:text-7xl lg:text-8xl font-black text-slate-900 tracking-tight font-mono selection:bg-blue-100">
          {currentTicket.ticket_number}
        </div>
      </div>

      <!-- Service Name -->
      <div class="text-slate-600 font-medium text-xs sm:text-sm bg-slate-50 px-4 py-1.5 rounded-full border border-slate-200">
        Kategori: <span id="current-service-name" class="font-bold text-slate-900">{serviceName || 'Layanan Antrian'}</span>
      </div>

      <!-- Service Timer / Stopwatch -->
      <div class="mt-2 bg-gradient-to-r from-slate-50 to-slate-100/80 border border-slate-200/80 rounded-2xl px-6 py-3 flex items-center space-x-3.5 shadow-2xs">
        <div class="p-2.5 rounded-xl bg-white border border-slate-200 text-blue-600 shadow-2xs">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="text-left">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Durasi Pelayanan</span>
          <span
            id="service-duration-timer"
            class="text-2xl sm:text-3xl font-black font-mono text-slate-900"
            data-served-at={currentTicket.served_at || ''}
            data-status={currentTicket.status}
          >
            00:00
          </span>
        </div>
      </div>
    </div>
  ) : (
    <div class="w-full py-10 sm:py-14 flex flex-col items-center justify-center space-y-4 text-slate-400">
      <div class="w-20 h-20 rounded-2xl bg-blue-50/80 border border-blue-100 flex items-center justify-center text-blue-500 shadow-2xs">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <div class="space-y-1">
        <h3 class="text-xl font-black text-slate-800 tracking-tight">Menunggu Panggilan Antrian</h3>
        <p class="text-xs sm:text-sm text-slate-500 max-w-sm mx-auto">Loket fisik siap melayani. Klik tombol "Panggil Berikutnya" untuk memanggil pengunjung sesuai urutan.</p>
      </div>
      <div class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
        Status Meja: <span class="uppercase ml-1.5 font-bold text-blue-600">{counterStatus}</span>
      </div>
    </div>
  )}
</div>
