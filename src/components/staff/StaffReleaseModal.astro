---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div
  id="staff-release-modal"
  class={`fixed inset-0 z-[70] hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 transition-opacity duration-200 ${className}`}
  role="dialog"
  aria-modal="true"
  aria-labelledby="release-modal-title"
>
  <div class="bg-white rounded-2xl shadow-xl max-w-md w-full overflow-hidden border border-slate-200 animate-in fade-in zoom-in-95 duration-150">
    <!-- Modal Header -->
    <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
        </div>
        <div>
          <h3 id="release-modal-title" class="text-lg font-bold text-slate-800">Tinggalkan Loket</h3>
          <p class="text-xs text-slate-500">Konfirmasi selesai bertugas di loket ini</p>
        </div>
      </div>
      <button
        id="btn-close-release-modal"
        type="button"
        class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-100 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-6 space-y-4">
      <p class="text-sm text-slate-600">
        Apakah Anda yakin ingin melepaskan loket ini? Loket akan kembali berstatus <span class="font-semibold text-slate-800">IDLE</span> dan dapat dijaga oleh petugas lain.
      </p>

      <!-- Busy Protection Warning (shown when active ticket exists) -->
      <div id="release-busy-warning" class="hidden p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-800">
        <div class="flex items-start space-x-2">
          <svg class="w-4 h-4 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div>
            <span class="font-bold">Perhatian:</span> Loket masih memiliki tiket yang aktif dipanggil atau sedang dilayani. Harap selesaikan atau tunda tiket terlebih dahulu sebelum meninggalkan loket.
          </div>
        </div>
      </div>

      <div id="release-error-alert" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700"></div>
    </div>

    <!-- Modal Footer -->
    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end space-x-3">
      <button
        id="btn-cancel-release"
        type="button"
        class="px-4 py-2 text-sm font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-200/70 rounded-xl transition-colors cursor-pointer"
      >
        Batal
      </button>
      <button
        id="btn-confirm-release"
        type="button"
        class="px-5 py-2 text-sm font-semibold text-white bg-amber-600 hover:bg-amber-700 rounded-xl shadow-xs transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 cursor-pointer"
      >
        Lepaskan Loket
      </button>
    </div>
  </div>
</div>
