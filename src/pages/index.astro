---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="AntriAja" description="AntriAja: Sistem Manajemen Antrian Cloud Cerdas, Mandiri & Paperless">
  <!-- Top Navigation Bar -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center font-black text-xl shadow-sm">
          A
        </div>
        <div>
          <span class="text-xl font-bold text-slate-900 tracking-tight">AntriAja</span>
          <span class="hidden sm:inline-block ml-2 text-xs font-semibold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
            Cloud SaaS
          </span>
        </div>
      </div>

      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
        <a href="#fitur" class="hover:text-blue-600 transition-colors">Keunggulan</a>
        <a href="#modul" class="hover:text-blue-600 transition-colors">Modul Sistem</a>
        <a href="#cara-kerja" class="hover:text-blue-600 transition-colors">Cara Kerja</a>
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href="/staff/login"
          class="px-3.5 py-2 text-xs sm:text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
        >
          Masuk Staf
        </a>
        <a
          href="/admin/login"
          class="px-3.5 py-2 text-xs sm:text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
        >
          Masuk Admin
        </a>
        <a
          href="/register"
          class="px-3.5 py-2 text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-colors"
        >
          Daftar Gratis
        </a>
      </div>
    </div>
  </header>

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/70 via-white to-slate-50 pt-14 pb-20 px-4 sm:px-6 lg:px-8 border-b border-slate-200">
      <div class="max-w-5xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs sm:text-sm font-semibold mb-6 border border-blue-200">
          <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
          Cloud Queue Management SaaS — Modern & Paperless
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight sm:leading-tight mb-6">
          <span class="text-blue-600">AntriAja</span>: Sistem Manajemen Antrian Cerdas, Mandiri &amp; Bebas Antri
        </h1>

        <p class="text-base sm:text-lg lg:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed mb-8 sm:mb-10">
          Transformasi sistem antrian konvensional menjadi solusi mandiri berbasis web. Mendukung konsep 
          <span class="font-semibold text-slate-800">Bring Your Own Device (BYOD)</span> untuk klinik, perbankan, instansi publik, dan pusat layanan tanpa hardware proprietary mahal.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 max-w-lg mx-auto">
          <a
            href="/register"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-md hover:shadow-lg transition-all"
          >
            <span>🚀 Daftar Gratis Sekarang</span>
            <span class="text-emerald-200">&rarr;</span>
          </a>
          <a
            href="/kiosk"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-md hover:shadow-lg transition-all"
          >
            <span>🖥️ Kiosk Mandiri</span>
          </a>
          <a
            href="/display"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-slate-800 bg-white hover:bg-slate-100 border border-slate-300 shadow-sm transition-all"
          >
            <span>📺 Layar Display TV</span>
          </a>
        </div>

        <!-- Quick Trust Badges -->
        <div class="mt-12 pt-8 border-t border-slate-200/80 flex flex-wrap justify-center items-center gap-6 sm:gap-10 text-xs sm:text-sm text-slate-500 font-medium">
          <div class="flex items-center gap-2">
            <span class="text-green-600 font-bold">✓</span> Paperless via QR Code
          </div>
          <div class="flex items-center gap-2">
            <span class="text-green-600 font-bold">✓</span> Realtime Sync &lt; 1 Detik
          </div>
          <div class="flex items-center gap-2">
            <span class="text-green-600 font-bold">✓</span> Suara Panggilan Otomatis Bahasa Indonesia
          </div>
          <div class="flex items-center gap-2">
            <span class="text-green-600 font-bold">✓</span> PWA & Offline Resilient
          </div>
        </div>
      </div>
    </section>

    <!-- Value Proposition Section -->
    <section id="fitur" class="py-16 px-4 sm:px-6 lg:px-8 bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-xs sm:text-sm font-bold tracking-wider text-blue-600 uppercase mb-2">Nilai Tambah Platform</h2>
          <p class="text-2xl sm:text-3xl font-extrabold text-slate-900">Kenapa Memilih AntriAja?</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
            <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-2xl font-bold">
              📱
            </div>
            <h3 class="text-lg font-bold text-slate-900">Paperless & Scan QR Pintar</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Pengunjung tidak wajib mencetak kertas fisik. Cukup pindai QR Code di layar kiosk dan pantau pergerakan nomor langsung dari smartphone.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
            <div class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-2xl font-bold">
              💻
            </div>
            <h3 class="text-lg font-bold text-slate-900">Zero Hardware Lock-In</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Gunakan perangkat apa pun: tablet untuk kiosk, Smart TV/browser untuk display, dan PC staf untuk konsol loket. Tanpa biaya hardware khusus.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
            <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-2xl font-bold">
              ⚡
            </div>
            <h3 class="text-lg font-bold text-slate-900">Sinkronisasi Realtime SSE</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Ditenagai broker Server-Sent Events (SSE) Golang yang cepat dan andal. Seluruh layar dan smartphone ter-update seketika di bawah 1 detik.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- All Core Modules Section -->
    <section id="modul" class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-slate-50 border-b border-slate-200">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <h2 class="text-xs sm:text-sm font-bold tracking-wider text-blue-600 uppercase mb-2">Ekosistem Terintegrasi</h2>
          <p class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Katalog Modul & Fungsionalitas</p>
          <p class="text-sm sm:text-base text-slate-600 mt-3">
            Pilih portal di bawah ini untuk mengakses atau menguji setiap modul antrian yang tersedia secara langsung.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          <!-- 1. Kiosk Mandiri -->
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl">🖥️</span>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
                  Touchscreen / Kiosk
                </span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Kiosk Mandiri Pintu Masuk</h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-4">
                Antarmuka layar sentuh pintu masuk tempat pengunjung memilih kategori layanan mandiri, mengambil nomor tiket reguler atau jalur cepat VIP dengan proteksi PIN, serta cetak struk thermal atau scan QR tiket paperless.
              </p>
              <div class="flex flex-wrap gap-1.5 mb-6">
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Tiket Reguler</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Keypad PIN VIP</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">QR Paperless</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Print 58/80mm</span>
              </div>
            </div>
            <a
              href="/kiosk"
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 transition-colors"
            >
              <span>Buka Kiosk Mandiri</span>
              <span>&rarr;</span>
            </a>
          </div>

          <!-- 2. Display TV -->
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl">📺</span>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-purple-50 text-purple-700 border border-purple-200">
                  Smart TV 16:9
                </span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Display TV Ruang Tunggu</h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-4">
                Monitor panggilan ruang tunggu split-screen 16:9 yang menampilkan nomor panggilan aktif raksasa dengan animasi highlight, riwayat nomor terpanggil, pemutar media promosi/edukasi, running text, dan suara panggilan otomatis Bahasa Indonesia.
              </p>
              <div class="flex flex-wrap gap-1.5 mb-6">
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Split Screen 16:9</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Suara Panggilan Otomatis</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Media Promo</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Running Text</span>
              </div>
            </div>
            <a
              href="/display"
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-sm font-semibold text-white bg-purple-600 hover:bg-purple-700 transition-colors"
            >
              <span>Buka Display TV</span>
              <span>&rarr;</span>
            </a>
          </div>

          <!-- 3. Mobile Pengunjung -->
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl">📱</span>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                  Smartphone Pengunjung
                </span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Tiket Mobile Pengunjung</h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-4">
                Halaman web mandiri pengunjung via scan QR Code dari smartphone tanpa perlu login atau unduh aplikasi. Pengunjung dapat memantau sisa nomor antrian di depan, estimasi waktu tunggu, dan notifikasi getar/chime saat nomor dipanggil.
              </p>
              <div class="flex flex-wrap gap-1.5 mb-6">
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Paperless QR</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Live Queue Monitor</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Estimasi Waktu</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Haptic Alert</span>
              </div>
            </div>
            <a
              href="/ticket"
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 transition-colors"
            >
              <span>Buka Tiket Mobile</span>
              <span>&rarr;</span>
            </a>
          </div>

          <!-- 4. Konsol Petugas Loket -->
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl">👤</span>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 border border-amber-200">
                  PC / Meja Staf
                </span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Konsol Petugas Loket</h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-4">
                Meja operasional staf loket untuk memilih loket aktif, memanggil tiket antrian berikutnya (FIFO & VIP First), panggil ulang, mulai melayani pengunjung dengan stopwatch durasi pelayanan, menunda tiket (*hold*), serta mengalihkan (*transfer*) ke layanan lain.
              </p>
              <div class="flex flex-wrap gap-1.5 mb-6">
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Panggil Berikutnya</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Tunda (Hold)</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Oper Layanan</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Stopwatch Durasi</span>
              </div>
            </div>
            <div class="flex gap-2">
              <a
                href="/staff"
                class="flex-1 inline-flex items-center justify-center py-2.5 px-3 rounded-xl text-xs sm:text-sm font-semibold text-white bg-amber-600 hover:bg-amber-700 transition-colors"
              >
                Buka Konsol Staf
              </a>
              <a
                href="/staff/login"
                class="inline-flex items-center justify-center py-2.5 px-3 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors"
                title="Login Petugas Loket"
              >
                Login
              </a>
            </div>
          </div>

          <!-- 5. Panel Administrasi Cabang -->
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl">⚙️</span>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-300">
                  Supervisor / Admin
                </span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Panel Administrasi Cabang</h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-4">
                Pusat kendali supervisor untuk memantau ringkasan traffic antrian harian, mengelola master kategori layanan (prefix & estimasi waktu), penugasan relasi multi-layanan ke loket (M:N), kustomisasi tampilan TV, dan eksekusi darurat reset antrian harian.
              </p>
              <div class="flex flex-wrap gap-1.5 mb-6">
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Master Layanan</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Pemetaan M:N Loket</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Display Settings</span>
                <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Reset Antrian Harian</span>
              </div>
            </div>
            <div class="flex gap-2">
              <a
                href="/admin"
                class="flex-1 inline-flex items-center justify-center py-2.5 px-3 rounded-xl text-xs sm:text-sm font-semibold text-white bg-slate-800 hover:bg-slate-900 transition-colors"
              >
                Dashboard Admin
              </a>
              <a
                href="/admin/login"
                class="inline-flex items-center justify-center py-2.5 px-3 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors"
                title="Login Administrator"
              >
                Login
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section id="cara-kerja" class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <h2 class="text-xs sm:text-sm font-bold tracking-wider text-blue-600 uppercase mb-2">Alur Operasional</h2>
          <p class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Cara Kerja Sistem Antrian</p>
          <p class="text-sm sm:text-base text-slate-600 mt-3">
            Pengalaman antrian yang tertata rapi, transparan, dan terhubung secara instan dalam 4 langkah mudah.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
          <div class="relative p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col">
            <div class="w-10 h-10 rounded-xl bg-blue-600 text-white font-bold flex items-center justify-center mb-4 text-base">
              1
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-2">Ambil Tiket di Kiosk</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Pengunjung memilih kategori layanan di layar sentuh kiosk pintu masuk. Tiket diterbitkan berupa cetak struk atau QR Code di smartphone.
            </p>
          </div>

          <div class="relative p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col">
            <div class="w-10 h-10 rounded-xl bg-blue-600 text-white font-bold flex items-center justify-center mb-4 text-base">
              2
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-2">Tunggu & Pantau Antrian</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Pengunjung dapat menunggu santai di ruang tunggu sambil memantau nomor di Layar Display TV atau memantau progres sisa antrian di smartphone.
            </p>
          </div>

          <div class="relative p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col">
            <div class="w-10 h-10 rounded-xl bg-blue-600 text-white font-bold flex items-center justify-center mb-4 text-base">
              3
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-2">Panggilan Loket Otomatis</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Petugas loket menekan tombol panggil di konsol staf. Display TV memicu visual highlight dan suara panggilan otomatis Bahasa Indonesia.
            </p>
          </div>

          <div class="relative p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col">
            <div class="w-10 h-10 rounded-xl bg-blue-600 text-white font-bold flex items-center justify-center mb-4 text-base">
              4
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-2">Selesai Dilayani / Dialihkan</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Setelah pelayanan tuntas, staf menandai tiket selesai atau mengalihkan antrian ke loket/layanan lain tanpa perlu membuat tiket baru.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-slate-900 text-slate-400 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-black text-sm">
          A
        </div>
        <div>
          <span class="text-white font-bold text-base tracking-tight">AntriAja</span>
          <p class="text-xs text-slate-500">Cloud Queue Management SaaS Platform</p>
        </div>
      </div>

      <div class="text-center md:text-right text-xs text-slate-500 leading-relaxed">
        <p>Dibangun dengan <span class="text-slate-300 font-medium">Astro v7</span>, <span class="text-slate-300 font-medium">Tailwind CSS v4</span>, &amp; <span class="text-slate-300 font-medium">PWA Offline-Ready</span>.</p>
        <p>Didukung backend <span class="text-slate-300 font-medium">Golang Fiber</span> &amp; <span class="text-slate-300 font-medium">PostgreSQL</span>.</p>
      </div>
    </div>
  </footer>
</BaseLayout>
