---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Daftar Instansi Baru - AntriAja" description="Daftar akun instansi baru di AntriAja Cloud Queue Management SaaS">
  <div class="min-h-screen bg-slate-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <!-- Brand Header -->
    <div class="sm:mx-auto sm:w-full sm:max-w-xl text-center px-4">
      <a href="/" class="inline-flex items-center gap-3 mb-4 group">
        <div class="w-12 h-12 rounded-2xl bg-blue-600 text-white flex items-center justify-center font-black text-2xl shadow-md group-hover:scale-105 transition-transform">
          A
        </div>
        <span class="text-2xl font-black text-slate-900 tracking-tight">AntriAja</span>
      </a>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Daftar Instansi Baru
      </h1>
      <p class="mt-2 text-sm text-slate-600">
        Mulai kelola antrian cerdas, mandiri, dan paperless untuk instansi Anda dalam 2 menit.
      </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-xl px-4 sm:px-0">
      <div class="bg-white py-8 px-6 shadow-xl shadow-slate-200/60 rounded-2xl border border-slate-200 sm:px-10">
        <!-- Error Alert -->
        <div id="alert-register-error" class="hidden mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm flex items-start gap-3">
          <svg class="w-5 h-5 text-rose-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="alert-error-message">Terjadi kesalahan pada pendaftaran.</span>
        </div>

        <form id="form-register" class="space-y-6">
          <!-- Step 1: Informasi Instansi -->
          <div>
            <div class="flex items-center gap-2 pb-2 mb-4 border-b border-slate-100">
              <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-600 font-bold text-xs flex items-center justify-center">1</span>
              <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Profil Instansi / Kantor Cabang</h2>
            </div>

            <div class="space-y-4">
              <div>
                <label for="input-tenant-name" class="block text-xs font-semibold text-slate-700 mb-1">
                  Nama Instansi / Usaha <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="input-tenant-name"
                  name="name"
                  required
                  placeholder="Contoh: Klinik Pratama Sehat, Bank Syariah Cab. Thamrin"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                />
              </div>

              <div>
                <label for="input-tenant-slug" class="block text-xs font-semibold text-slate-700 mb-1">
                  Subdomain / Slug Antrian <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                  <input
                    type="text"
                    id="input-tenant-slug"
                    name="slug"
                    required
                    pattern="[a-z0-9]+(-[a-z0-9]+)*"
                    placeholder="klinik-sehat"
                    class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-slate-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors lowercase"
                  />
                </div>
                <p id="slug-preview" class="mt-1 text-xs text-slate-500 font-mono">
                  URL Kiosk: antriaja.com/kiosk/<span class="text-blue-600 font-semibold" id="slug-preview-text">...</span>
                </p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="input-tenant-phone" class="block text-xs font-semibold text-slate-700 mb-1">
                    No. Telepon / WhatsApp
                  </label>
                  <input
                    type="tel"
                    id="input-tenant-phone"
                    name="phone"
                    placeholder="081234567890"
                    class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                  />
                </div>
                <div>
                  <label for="select-tenant-timezone" class="block text-xs font-semibold text-slate-700 mb-1">
                    Zona Waktu Operasional
                  </label>
                  <select
                    id="select-tenant-timezone"
                    name="timezone"
                    class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-slate-900 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                  >
                    <option value="Asia/Jakarta">Asia/Jakarta (WIB, UTC+7)</option>
                    <option value="Asia/Makassar">Asia/Makassar (WITA, UTC+8)</option>
                    <option value="Asia/Jayapura">Asia/Jayapura (WIT, UTC+9)</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="input-tenant-address" class="block text-xs font-semibold text-slate-700 mb-1">
                  Alamat Fisik Cabang
                </label>
                <textarea
                  id="input-tenant-address"
                  name="address"
                  rows="2"
                  placeholder="Jl. Jenderal Sudirman No. 45, Lantai 1"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors resize-none"
                ></textarea>
              </div>
            </div>
          </div>

          <!-- Step 2: Akun Administrator Utama -->
          <div class="pt-4 border-t border-slate-100">
            <div class="flex items-center gap-2 pb-2 mb-4 border-b border-slate-100">
              <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-600 font-bold text-xs flex items-center justify-center">2</span>
              <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Kredensial Administrator Utama</h2>
            </div>

            <div class="space-y-4">
              <div>
                <label for="input-admin-name" class="block text-xs font-semibold text-slate-700 mb-1">
                  Nama Lengkap Admin <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="input-admin-name"
                  name="admin_name"
                  required
                  placeholder="Contoh: Budi Santoso"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                />
              </div>

              <div>
                <label for="input-admin-email" class="block text-xs font-semibold text-slate-700 mb-1">
                  Email Administrator <span class="text-rose-500">*</span>
                </label>
                <input
                  type="email"
                  id="input-admin-email"
                  name="admin_email"
                  required
                  placeholder="admin@instansi.com"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                />
              </div>

              <div>
                <label for="input-admin-password" class="block text-xs font-semibold text-slate-700 mb-1">
                  Kata Sandi Baru <span class="text-rose-500">*</span>
                </label>
                <input
                  type="password"
                  id="input-admin-password"
                  name="admin_password"
                  required
                  minlength="8"
                  placeholder="Minimal 8 karakter"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                />
                <p class="mt-1 text-xs text-slate-500">Gunakan kombinasi huruf dan angka agar kata sandi kuat.</p>
              </div>
            </div>
          </div>

          <!-- Submit Action -->
          <div class="pt-2">
            <button
              type="submit"
              id="btn-register-submit"
              class="w-full py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold text-sm shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span id="btn-text">Daftar &amp; Lanjut ke Setup</span>
              <svg id="btn-spinner" class="hidden animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>
        </form>

        <div class="mt-6 text-center text-xs text-slate-600 pt-6 border-t border-slate-100">
          Sudah memiliki akun instansi?{' '}
          <a href="/admin/login" class="font-bold text-blue-600 hover:text-blue-700 hover:underline">
            Masuk ke Panel Admin
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { registerTenant } from '../services/authService';
  import { storage } from '../lib/storage';

  const form = document.getElementById('form-register') as HTMLFormElement | null;
  const nameInput = document.getElementById('input-tenant-name') as HTMLInputElement | null;
  const slugInput = document.getElementById('input-tenant-slug') as HTMLInputElement | null;
  const slugPreviewText = document.getElementById('slug-preview-text');
  const alertError = document.getElementById('alert-register-error');
  const alertMessage = document.getElementById('alert-error-message');
  const submitBtn = document.getElementById('btn-register-submit') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');

  let slugManuallyEdited = false;

  // Auto-format slug from name if not manually edited
  nameInput?.addEventListener('input', () => {
    if (!slugManuallyEdited && slugInput) {
      const generated = nameInput.value
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');
      slugInput.value = generated;
      if (slugPreviewText) slugPreviewText.textContent = generated || '...';
    }
  });

  slugInput?.addEventListener('input', () => {
    slugManuallyEdited = true;
    const sanitized = slugInput.value
      .toLowerCase()
      .replace(/[^a-z0-9-]+/g, '')
      .replace(/-+/g, '-');
    slugInput.value = sanitized;
    if (slugPreviewText) slugPreviewText.textContent = sanitized || '...';
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    if (alertError) alertError.classList.add('hidden');

    const formData = new FormData(form);
    const name = String(formData.get('name') || '').trim();
    const slug = String(formData.get('slug') || '').trim();
    const admin_name = String(formData.get('admin_name') || '').trim();
    const admin_email = String(formData.get('admin_email') || '').trim();
    const admin_password = String(formData.get('admin_password') || '');
    const phone = String(formData.get('phone') || '').trim();
    const address = String(formData.get('address') || '').trim();
    const timezone = String(formData.get('timezone') || 'Asia/Jakarta');

    if (!name || !slug || !admin_name || !admin_email || !admin_password) {
      showError('Semua kolom bertanda bintang (*) wajib diisi.');
      return;
    }

    if (admin_password.length < 8) {
      showError('Kata sandi harus memiliki panjang minimal 8 karakter.');
      return;
    }

    // Disable submit
    submitBtn.disabled = true;
    if (btnText) btnText.textContent = 'Mendaftarkan...';
    if (btnSpinner) btnSpinner.classList.remove('hidden');

    try {
      const resp = await registerTenant({
        name,
        slug,
        admin_name,
        admin_email,
        admin_password,
        phone: phone || undefined,
        address: address || undefined,
        timezone,
      });

      if (!resp.success || !resp.data) {
        if (resp.error?.code === 'SLUG_ALREADY_EXISTS') {
          showError('Subdomain / slug instansi tersebut sudah terpakai. Silakan tentukan slug yang lain.');
        } else if (resp.error?.code === 'EMAIL_ALREADY_EXISTS') {
          showError('Email administrator tersebut sudah terdaftar di sistem.');
        } else {
          showError(resp.error?.message || 'Pendaftaran gagal. Silakan periksa kembali data Anda.');
        }
        return;
      }

      // Simpan credentials & token
      storage.setToken(resp.data.token);

      // Simpan metadata onboarding sementara
      sessionStorage.setItem('antriaja_onboarding_data', JSON.stringify({
        tenant: resp.data.tenant,
        admin: resp.data.admin,
      }));

      // Redirect ke Onboarding Setup Wizard
      window.location.href = '/onboarding';
    } catch (err: any) {
      showError(err?.message || 'Terjadi gangguan jaringan saat menghubungkan ke server.');
    } finally {
      submitBtn.disabled = false;
      if (btnText) btnText.textContent = 'Daftar & Lanjut ke Setup';
      if (btnSpinner) btnSpinner.classList.add('hidden');
    }
  });

  function showError(msg: string) {
    if (alertMessage) alertMessage.textContent = msg;
    if (alertError) alertError.classList.remove('hidden');
  }
</script>
