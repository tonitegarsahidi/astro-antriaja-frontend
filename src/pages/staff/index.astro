  // ==================== REALTIME SSE SINKRONISASI ====================

  function connectRealtimeSSE(token: string) {
    if (sseClient) {
      sseClient.disconnect();
    }

    const sseStatusBadge = document.getElementById('sse-status-badge');
    const sseStatusText = document.getElementById('sse-status-text');

    sseClient = new SSEClient();
    sseClient.onStatusChange((status) => {
      if (!sseStatusBadge || !sseStatusText) return;
      if (status === 'connected') {
        sseStatusBadge.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200';
        sseStatusText.textContent = 'Realtime';
      } else {
        sseStatusBadge.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200';
        sseStatusText.textContent = 'Terputus';
      }
    });

    // Event Listeners
    sseClient.on('TICKET_CREATED', async () => {
      if (activeCounterId) await loadCounterState(activeCounterId);
    });

    sseClient.on('TICKET_CALLED', async () => {
      if (activeCounterId) await loadCounterState(activeCounterId);
    });

    sseClient.on('TICKET_SERVING', async () => {
      if (activeCounterId) await loadCounterState(activeCounterId);
    });

    sseClient.on('TICKET_HOLD', async () => {
      if (activeCounterId) await loadCounterState(activeCounterId);
    });

    sseClient.on('TICKET_TRANSFERRED', async () => {
      if (activeCounterId) await loadCounterState(activeCounterId);
    });

    sseClient.on('TICKET_COMPLETED', async () => {
      if (activeCounterId) await loadCounterState(activeCounterId);
    });

    sseClient.on('COUNTER_STATUS_CHANGED', async () => {
      if (activeCounterId) await loadCounterState(activeCounterId);
    });

    sseClient.on('QUEUE_RESET', async () => {
      showNotification('Siklus antrian harian telah direset oleh sistem/admin.', 'warning');
      if (activeCounterId) await loadCounterState(activeCounterId);
    });

    sseClient.connect({ token });
  }

  // ==================== TOAST / NOTIFICATION HELPER ====================

  function showNotification(message: string, type: 'info' | 'success' | 'warning' | 'error') {
    const banner = document.getElementById('staff-notification-banner');
    if (!banner) return;

    const colors = {
      info: 'bg-blue-50 text-blue-800 border border-blue-200',
      success: 'bg-emerald-50 text-emerald-800 border border-emerald-200',
      warning: 'bg-amber-50 text-amber-800 border border-amber-200',
      error: 'bg-rose-50 text-rose-800 border border-rose-200',
    };

    banner.className = `p-4 rounded-xl text-sm font-medium transition-all shadow-xs ${colors[type]}`;
    banner.textContent = message;
    banner.classList.remove('hidden');

    if (type !== 'error') {
      setTimeout(() => {
        banner.classList.add('hidden');
      }, 5000);
    }
  }

  function hideNotification() {
    const banner = document.getElementById('staff-notification-banner');
    if (banner) banner.classList.add('hidden');
  }

  // DOM Boot
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStaffConsole);
  } else {
    initStaffConsole();
  }
</script>
