  // ==================== STOPWATCH TIMER ====================

  function startStopwatch(startTimeMs: number) {
    stopStopwatch();
    const timerEl = document.getElementById('service-duration-timer');

    function tick() {
      const now = Date.now();
      const diffSec = Math.max(0, Math.floor((now - startTimeMs) / 1000));
      const mins = Math.floor(diffSec / 60);
      const secs = diffSec % 60;
      const formatted = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
      if (timerEl) {
        timerEl.textContent = formatted;
      }
    }

    tick();
    stopwatchInterval = window.setInterval(tick, 1000);
  }

  function stopStopwatch() {
    if (stopwatchInterval !== null) {
      clearInterval(stopwatchInterval);
      stopwatchInterval = null;
    }
    const timerEl = document.getElementById('service-duration-timer');
    if (timerEl) {
      timerEl.textContent = '00:00';
    }
  }

  // ==================== OPERATIONAL ACTIONS ====================

  function setupActionButtons() {
    const btnCallNext = document.getElementById('btn-call-next');
    const btnRecall = document.getElementById('btn-recall');
    const btnServe = document.getElementById('btn-serve');
    const btnHold = document.getElementById('btn-hold');
    const btnComplete = document.getElementById('btn-complete');
    const btnTransfer = document.getElementById('btn-transfer');

    btnCallNext?.addEventListener('click', async () => {
      if (!activeCounterId) return;
      showNotification('Memanggil antrian berikutnya...', 'info');
      const res = await callNext(activeCounterId);
      if (!res.success) {
        showNotification(res.error?.message || 'Gagal memanggil antrian', 'error');
        return;
      }
      showNotification(`Memanggil tiket ${res.data?.ticket_number}`, 'success');
      await loadCounterState(activeCounterId);
    });

    btnRecall?.addEventListener('click', async () => {
      if (!activeCounterId || !activeState?.current_ticket) return;
      showNotification('Memanggil ulang pengunjung...', 'info');
      const res = await recall(activeCounterId, activeState.current_ticket.id);
      if (!res.success) {
        showNotification(res.error?.message || 'Gagal memanggil ulang', 'error');
        return;
      }
      showNotification(`Panggilan ulang terkirim untuk ${res.data?.ticket_number}`, 'success');
    });

    btnServe?.addEventListener('click', async () => {
      if (!activeCounterId || !activeState?.current_ticket) return;
      const res = await serve(activeCounterId, activeState.current_ticket.id);
      if (!res.success) {
        showNotification(res.error?.message || 'Gagal memulai layanan', 'error');
        return;
      }
      showNotification('Pelayanan dimulai. Stopwatch aktif.', 'success');
      await loadCounterState(activeCounterId);
    });

    btnHold?.addEventListener('click', async () => {
      if (!activeCounterId || !activeState?.current_ticket) return;
      const res = await hold(activeCounterId, activeState.current_ticket.id);
      if (!res.success) {
        showNotification(res.error?.message || 'Gagal menunda tiket', 'error');
        return;
      }
      showNotification(`Tiket ${res.data?.ticket_number} ditunda ke daftar tunda.`, 'warning');
      await loadCounterState(activeCounterId);
    });

    btnComplete?.addEventListener('click', async () => {
      if (!activeCounterId || !activeState?.current_ticket) return;
      const currentTkt = activeState.current_ticket;
      const res = await complete(activeCounterId, currentTkt.id);
      if (!res.success) {
        showNotification(res.error?.message || 'Gagal menyelesaikan tiket', 'error');
        return;
      }
      let elapsedSec = 60;
      if (currentTkt.served_at) {
        elapsedSec = Math.max(
          1,
          Math.round((Date.now() - new Date(currentTkt.served_at).getTime()) / 1000)
        );
      }
      updateSidebarStats(elapsedSec);
      showNotification(`Pelayanan tiket ${res.data?.ticket_number} selesai.`, 'success');
      await loadCounterState(activeCounterId);
    });

    btnTransfer?.addEventListener('click', () => {
      if (!activeState?.current_ticket) return;
      openTransferModal();
    });
  }

  async function handleCallHold(ticketId: string) {
    if (!activeCounterId) return;
    showNotification('Memanggil tiket dari daftar tunda...', 'info');
    const res = await callHold(activeCounterId, ticketId);
    if (!res.success) {
      showNotification(res.error?.message || 'Gagal memanggil tiket tunda', 'error');
      return;
    }
    showNotification(`Tiket ${res.data?.ticket_number} berhasil dipanggil kembali`, 'success');
    await loadCounterState(activeCounterId);
  }

  // ==================== COUNTER SELECTOR & OCCUPY ====================

  async function showCounterSelectorModal() {
    const modal = document.getElementById('counter-selector-modal');
    const listContainer = document.getElementById('counter-list-container');
    const loadingEl = document.getElementById('counter-list-loading');
    const errorAlert = document.getElementById('occupy-error-alert');
    const selectedInfo = document.getElementById('selected-counter-info');
    const btnClose = document.getElementById('btn-close-counter-modal');
    const btnRefresh = document.getElementById('btn-refresh-counter-list');

    if (!modal || !listContainer || !loadingEl) return;

    modal.classList.remove('hidden');
    if (errorAlert) errorAlert.classList.add('hidden');

    // Close button handling (allow closing if staff already has active counter)
    if (btnClose) {
      if (activeCounterId) {
        btnClose.classList.remove('hidden');
        btnClose.onclick = () => modal?.classList.add('hidden');
      } else {
        btnClose.classList.add('hidden');
        btnClose.onclick = null;
      }
    }

    let isSubmitting = false;

    async function loadCounters() {
      if (!listContainer || !loadingEl) return;
      listContainer.classList.add('hidden');
      loadingEl.classList.remove('hidden');
      if (errorAlert) errorAlert.classList.add('hidden');
      if (selectedInfo) selectedInfo.textContent = 'Klik loket yang tersedia untuk langsung bertugas';

      const res = await listCounters();
      loadingEl.classList.add('hidden');
      listContainer.classList.remove('hidden');

      if (!res.success || !res.data) {
        if (errorAlert) {
          errorAlert.textContent = res.error?.message || 'Gagal memuat daftar loket cabang.';
          errorAlert.classList.remove('hidden');
        }
        return;
      }

      const counters = res.data;
      if (counters.length === 0) {
        listContainer.innerHTML = '<p class="text-sm text-slate-500 text-center py-6">Belum ada loket fisik yang terdaftar.</p>';
        return;
      }

      const currentUser = getUser();

      listContainer.innerHTML = counters
        .map((c) => {
          const isMyCounter = activeCounterId === c.id || (currentUser && c.current_staff_id === currentUser.id);
          const isOccupiedByOther = !!c.current_staff_id && !isMyCounter;

          return `
          <div
            class="counter-option-card group relative p-4 rounded-xl border transition-all ${
              isOccupiedByOther
                ? 'bg-slate-50 border-slate-200 opacity-60 cursor-not-allowed'
                : isMyCounter
                ? 'bg-blue-50/60 border-blue-300 ring-2 ring-blue-400 hover:border-blue-500 cursor-pointer shadow-xs'
                : 'bg-white border-slate-200 hover:border-blue-400 hover:bg-blue-50/20 hover:shadow-md cursor-pointer'
            }"
            data-counter-id="${c.id}"
            data-counter-number="${c.counter_number}"
            data-is-occupied="${isOccupiedByOther}"
            data-is-my-counter="${isMyCounter}"
          >
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center space-x-3.5 min-w-0">
                <span class="w-10 h-10 rounded-xl ${
                  isMyCounter ? 'bg-blue-600 text-white' : 'bg-blue-100 text-blue-700'
                } font-black text-base flex items-center justify-center font-mono shrink-0 shadow-2xs">
                  ${c.counter_number}
                </span>
                <div class="min-w-0">
                  <div class="flex items-center space-x-2">
                    <h4 class="font-bold text-sm text-slate-900 truncate">${c.name || `Loket ${c.counter_number}`}</h4>
                    ${
                      isMyCounter
                        ? `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800 border border-blue-200">
                            Loket Anda
                          </span>`
                        : ''
                    }
                  </div>
                  <p class="text-xs text-slate-500 truncate mt-0.5">
                    ${c.services && c.services.length > 0 ? c.services.map((s) => `[${s.prefix}] ${s.name}`).join(', ') : 'Semua Layanan'}
                  </p>
                </div>
              </div>

              <div class="shrink-0 flex items-center space-x-2">
                ${
                  isOccupiedByOther
                    ? `<span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-200 text-slate-700">
                        Dijaga: ${c.current_staff?.full_name || 'Staf Lain'}
                      </span>`
                    : isMyCounter
                    ? `<button type="button" class="btn-action-counter inline-flex items-center space-x-1 px-3.5 py-2 rounded-xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-2xs pointer-events-none">
                        <span>Lanjutkan Bertugas</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                      </button>`
                    : `<button type="button" class="btn-action-counter inline-flex items-center space-x-1 px-3.5 py-2 rounded-xl text-xs font-bold text-blue-600 group-hover:text-white bg-blue-50 group-hover:bg-blue-600 border border-blue-200 group-hover:border-blue-600 shadow-2xs transition-all pointer-events-none">
                        <span>Pilih & Jaga Loket</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                      </button>`
                }
              </div>
            </div>
          </div>
        `;
        })
        .join('');

      // 1-Click Occupy Listener
      listContainer.querySelectorAll('.counter-option-card').forEach((cardEl) => {
        cardEl.addEventListener('click', async (e) => {
          if (isSubmitting) return;
          const el = e.currentTarget as HTMLElement;
          const isOccupiedOther = el.dataset.isOccupied === 'true';
          const isMyCounter = el.dataset.isMyCounter === 'true';
          const cid = el.dataset.counterId;
          const cnum = el.dataset.counterNumber;

          if (isOccupiedOther) {
            if (errorAlert) {
              errorAlert.textContent = `Loket ${cnum} sedang dijaga oleh staf lain. Silakan pilih loket yang kosong.`;
              errorAlert.classList.remove('hidden');
            }
            return;
          }

          if (!cid) return;

          // If already my counter, just close modal and ensure state loaded
          if (isMyCounter && activeCounterId === cid) {
            modal?.classList.add('hidden');
            return;
          }

          isSubmitting = true;
          if (errorAlert) errorAlert.classList.add('hidden');

          // Visual loading state on the clicked card
          const actionBtn = el.querySelector('.btn-action-counter');
          const originalBtnHtml = actionBtn?.innerHTML;
          if (actionBtn) {
            actionBtn.innerHTML = `
              <div class="w-3.5 h-3.5 border-2 border-current border-t-transparent rounded-full animate-spin"></div>
              <span>Menghubungkan...</span>
            `;
          }

          try {
            const occRes = await occupyCounter(cid);
            if (!occRes.success) {
              if (errorAlert) {
                errorAlert.textContent = occRes.error?.message || `Gagal menduduki Loket ${cnum}.`;
                errorAlert.classList.remove('hidden');
              }
              if (actionBtn && originalBtnHtml) {
                actionBtn.innerHTML = originalBtnHtml;
              }
              isSubmitting = false;
              // Re-fetch to sync if another staff took it
              await loadCounters();
              return;
            }

            // Success: update state and dismiss modal
            setActiveCounterId(cid);
            activeCounterId = cid;
            modal?.classList.add('hidden');
            showNotification(`Berhasil menduduki Loket ${cnum}`, 'success');

            await loadCounterState(activeCounterId);
            const token = getToken();
            if (token) connectRealtimeSSE(token);
          } catch (err: unknown) {
            if (errorAlert) {
              errorAlert.textContent = 'Terjadi kesalahan jaringan saat menghubungkan ke loket.';
              errorAlert.classList.remove('hidden');
            }
            if (actionBtn && originalBtnHtml) {
              actionBtn.innerHTML = originalBtnHtml;
            }
          } finally {
            isSubmitting = false;
          }
        });
      });
    }

    if (btnRefresh) {
      btnRefresh.onclick = () => loadCounters();
    }

    await loadCounters();
  }

  // ==================== TRANSFER MODAL ====================

  function openTransferModal() {
    const modal = document.getElementById('transfer-modal');
    const selectEl = document.getElementById('select-target-service') as HTMLSelectElement | null;
    const ticketNumEl = document.getElementById('transfer-current-ticket-number');
    const errorAlert = document.getElementById('transfer-error-alert');

    if (!modal || !activeState?.current_ticket) return;

    if (ticketNumEl) ticketNumEl.textContent = activeState.current_ticket.ticket_number;
    if (errorAlert) errorAlert.classList.add('hidden');

    // Populate services dropdown
    if (selectEl && branchServices.length > 0) {
      selectEl.innerHTML = '<option value="" disabled selected>Pilih layanan tujuan...</option>' +
        branchServices
          .filter((s) => s.id !== activeState?.current_ticket?.service_id)
          .map((s) => `<option value="${s.id}">[${s.prefix}] ${s.name}</option>`)
          .join('');
    }

    modal.classList.remove('hidden');
  }

  function setupModalListeners() {
    // Transfer Modal Closers
    const transferModal = document.getElementById('transfer-modal');
    const btnCancelTransfer = document.getElementById('btn-cancel-transfer');
    const btnCloseTransfer = document.getElementById('btn-close-transfer-modal');
    const btnConfirmTransfer = document.getElementById('btn-confirm-transfer');

    const closeTransfer = () => transferModal?.classList.add('hidden');
    btnCancelTransfer?.addEventListener('click', closeTransfer);
    btnCloseTransfer?.addEventListener('click', closeTransfer);

    btnConfirmTransfer?.addEventListener('click', async () => {
      const selectEl = document.getElementById('select-target-service') as HTMLSelectElement | null;
      const errorAlert = document.getElementById('transfer-error-alert');
      const targetServiceId = selectEl?.value;

      if (!targetServiceId || !activeCounterId || !activeState?.current_ticket) {
        if (errorAlert) {
          errorAlert.textContent = 'Harap pilih layanan tujuan transfer.';
          errorAlert.classList.remove('hidden');
        }
        return;
      }

      const res = await transfer(activeCounterId, activeState.current_ticket.id, targetServiceId);
      if (!res.success) {
        if (errorAlert) {
          errorAlert.textContent = res.error?.message || 'Gagal mengalihkan tiket.';
          errorAlert.classList.remove('hidden');
        }
        return;
      }

      showNotification(`Tiket berhasil dialihkan ke layanan baru.`, 'success');
      closeTransfer();
      await loadCounterState(activeCounterId);
    });

    // Staff Release Modal Closers
    const releaseModal = document.getElementById('staff-release-modal');
    const btnCancelRelease = document.getElementById('btn-cancel-release');
    const btnCloseRelease = document.getElementById('btn-close-release-modal');
    const btnConfirmRelease = document.getElementById('btn-confirm-release');
    const releaseError = document.getElementById('release-error-alert');

    const closeRelease = () => releaseModal?.classList.add('hidden');
    btnCancelRelease?.addEventListener('click', closeRelease);
    btnCloseRelease?.addEventListener('click', closeRelease);

    btnConfirmRelease?.addEventListener('click', async () => {
      if (!activeCounterId) return;

      const res = await releaseCounter(activeCounterId);
      if (!res.success) {
        if (releaseError) {
          releaseError.textContent = res.error?.message || 'Gagal melepaskan loket.';
          releaseError.classList.remove('hidden');
        }
        return;
      }

      removeActiveCounterId();
      activeCounterId = null;
      activeState = null;
      closeRelease();

      const noCounterBanner = document.getElementById('no-counter-banner');
      if (noCounterBanner) noCounterBanner.classList.remove('hidden');

      showNotification('Loket berhasil dilepaskan. Silakan pilih loket baru jika ingin melanjutkan.', 'info');
      await showCounterSelectorModal();
    });
  }

  function setupHeaderListeners() {
    const releaseModal = document.getElementById('staff-release-modal');
    const busyWarning = document.getElementById('release-busy-warning');

    function triggerReleaseModal() {
      if (!releaseModal) return;
