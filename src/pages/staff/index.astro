    const btnSelectCounterBanner = document.getElementById('btn-select-counter-banner');
    btnSelectCounterBanner?.addEventListener('click', async () => {
      await showCounterSelectorModal();
    });

    const counterBadge = document.getElementById('staff-counter-badge');
    counterBadge?.addEventListener('click', async () => {
      await showCounterSelectorModal();
    });

    const sidebarBtnChange = document.getElementById('sidebar-btn-change-counter');
    sidebarBtnChange?.addEventListener('click', async () => {
      await showCounterSelectorModal();
    });

    function triggerLogout() {
      if (confirm('Apakah Anda yakin ingin keluar dari Konsol Staf?')) {
        clearStorage();
        window.location.href = '/staff/login';
      }
