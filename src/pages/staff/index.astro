    }

    container.innerHTML = `
      <div class="overflow-hidden bg-white border border-slate-200 rounded-xl shadow-sm">
        <ul id="hold-list-items" class="divide-y divide-slate-100">
          ${tickets
            .map(
              (t) => `
            <li class="p-4 flex items-center justify-between transition-colors hover:bg-slate-50/80">
              <div class="flex items-center space-x-4">
                <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <div class="flex items-center space-x-2">
                    <span class="text-lg font-black font-mono text-slate-800">${t.ticket_number}</span>
                    ${
                      t.is_vip
                        ? `<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">VIP</span>`
