---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
---

<PlatformLayout title="Dashboard Platform - AntriAja Super-Admin" activePage="dashboard">
  <div class="p-6 md:p-8 space-y-8">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Ringkasan Platform</h1>
        <p class="text-sm text-slate-500 mt-1">
          Pantau metrik kesehatan, status operasional instansi, dan volume antrian seluruh tenant AntriAja.
        </p>
      </div>

      <div class="flex items-center space-x-3">
        <a
          id="btn-quick-add-tenant"
          href="/platform/tenants?action=create"
          class="inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-md shadow-indigo-600/20 transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Tambah Tenant Baru
        </a>
        <a
          id="btn-quick-manage-tenants"
          href="/platform/tenants"
          class="inline-flex items-center px-4 py-2 bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-sm font-semibold rounded-xl shadow-xs transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 mr-2 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          Kelola Semua Tenant
        </a>
      </div>
    </div>

    <!-- Stat Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <!-- Total Tenants -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-xs relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Instansi</span>
          <div class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
        </div>
        <div class="mt-4 flex items-baseline justify-between">
          <span id="stat-total-tenants" class="text-3xl font-extrabold text-slate-900 tracking-tight">-</span>
          <span class="text-xs text-slate-500 font-medium">Terdaftar</span>
        </div>
      </div>

      <!-- Active Tenants -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-xs relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tenant Aktif</span>
          <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <div class="mt-4 flex items-baseline justify-between">
          <span id="stat-active-tenants" class="text-3xl font-extrabold text-emerald-600 tracking-tight">-</span>
          <span class="text-xs text-emerald-600 font-semibold bg-emerald-50 px-2 py-0.5 rounded-md">Online</span>
        </div>
      </div>

      <!-- Suspended Tenants -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-xs relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Ditangguhkan (Suspended)</span>
          <div class="w-9 h-9 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
            </svg>
          </div>
        </div>
        <div class="mt-4 flex items-baseline justify-between">
          <span id="stat-suspended-tenants" class="text-3xl font-extrabold text-rose-600 tracking-tight">-</span>
          <span class="text-xs text-rose-600 font-semibold bg-rose-50 px-2 py-0.5 rounded-md">Akses Diblokir</span>
        </div>
      </div>

      <!-- Total Tickets Today -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-xs relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Tiket Hari Ini</span>
          <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
            </svg>
          </div>
        </div>
        <div class="mt-4 flex items-baseline justify-between">
          <span id="stat-tickets-today" class="text-3xl font-extrabold text-blue-600 tracking-tight">-</span>
          <span class="text-xs text-slate-500 font-medium">Seluruh Cabang</span>
        </div>
      </div>
    </div>

    <!-- Overview Section & Quick Guide -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <h2 class="text-base font-bold text-slate-900">Panduan Operasional Super-Admin</h2>
          <span class="text-xs font-medium text-slate-400">Platform Control</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 space-y-2">
            <div class="w-7 h-7 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-xs">
              1
            </div>
            <h3 class="text-sm font-semibold text-slate-800">Supervisi & Penangguhan</h3>
            <p class="text-xs text-slate-500 leading-relaxed">
              Jika tenant menunggak pembayaran atau melanggar ToS, ubah status menjadi <strong>Suspended</strong>. Seluruh Kiosk, Display, dan Staf akan langsung diblokir.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 space-y-2">
            <div class="w-7 h-7 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-xs">
              2
            </div>
            <h3 class="text-sm font-semibold text-slate-800">Rotasi Kunci Perangkat Darurat</h3>
            <p class="text-xs text-slate-500 leading-relaxed">
              Jika terjadi kebocoran kunci Kiosk atau Display TV di lokasi tenant, lakukan rotasi paksa instan langsung dari konsol tenant.
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Platform Actions -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs flex flex-col justify-between">
        <div>
          <h2 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-4">Tindakan Cepat</h2>
          <div class="space-y-3 pt-4">
            <a
              href="/platform/tenants?action=create"
              class="flex items-center justify-between p-3 rounded-xl bg-indigo-50/50 hover:bg-indigo-50 border border-indigo-100 text-indigo-900 transition-colors"
            >
              <div class="flex items-center space-x-3">
                <span class="p-2 rounded-lg bg-indigo-600 text-white">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                </span>
                <div>
                  <span class="text-xs font-bold block">Provisioning Tenant</span>
                  <span class="text-[11px] text-slate-500 block">Buat tenant & admin manual</span>
                </div>
              </div>
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <a
              href="/platform/tenants"
              class="flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 transition-colors"
            >
              <div class="flex items-center space-x-3">
                <span class="p-2 rounded-lg bg-slate-800 text-white">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                  </svg>
                </span>
                <div>
                  <span class="text-xs font-bold block">Daftar Seluruh Tenant</span>
                  <span class="text-[11px] text-slate-500 block">Cari & kelola status</span>
                </div>
              </div>
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100 text-center">
          <span class="text-[11px] text-slate-400">AntriAja Enterprise Cloud Engine v2.0</span>
        </div>
      </div>
    </div>
  </div>
</PlatformLayout>

<script>
  import { getPlatformMetrics } from '../../services/platformService';

  document.addEventListener('DOMContentLoaded', async () => {
    const elTotal = document.getElementById('stat-total-tenants');
    const elActive = document.getElementById('stat-active-tenants');
    const elSuspended = document.getElementById('stat-suspended-tenants');
    const elTickets = document.getElementById('stat-tickets-today');

    try {
      const res = await getPlatformMetrics();
      if (res.success && res.data) {
        if (elTotal) elTotal.textContent = res.data.total_tenants.toLocaleString('id-ID');
        if (elActive) elActive.textContent = res.data.active_tenants.toLocaleString('id-ID');
        if (elSuspended) elSuspended.textContent = res.data.suspended_tenants.toLocaleString('id-ID');
        if (elTickets) elTickets.textContent = res.data.total_tickets_today.toLocaleString('id-ID');
      }
    } catch {
      // Graceful fallback
    }
  });
</script>
