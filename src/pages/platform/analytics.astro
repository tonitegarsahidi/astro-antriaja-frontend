---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
---

<PlatformLayout title="Statistik & Beban Server - AntriAja Super-Admin" activePage="analytics">
  <div class="p-6 md:p-8 space-y-8">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="flex items-center space-x-2">
          <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Statistik & Beban Server</h1>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-100 text-indigo-700 border border-indigo-200">
            METRICS & LOAD
          </span>
        </div>
        <p class="text-sm text-slate-500 mt-1">
          Analisis volume tiket seluruh tenant, visualisasi grafik harian, dan estimasi beban server untuk perencanaan kapasitas infrastruktur.
        </p>
      </div>

      <div class="flex items-center space-x-3">
        <button
          id="btn-refresh-analytics"
          type="button"
          class="inline-flex items-center px-4 py-2 bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-sm font-semibold rounded-xl shadow-xs transition-all cursor-pointer"
        >
          <svg id="icon-refresh" class="w-4 h-4 mr-2 text-slate-500 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Muat Ulang
        </button>
      </div>
    </div>

    <!-- Error Alert Container -->
    <div id="analytics-error-container" class="hidden p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-sm flex items-start space-x-3">
      <svg class="w-5 h-5 shrink-0 text-rose-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <h4 class="font-bold text-rose-900">Gagal Memuat Statistik</h4>
        <p id="analytics-error-message" class="text-xs text-rose-600 mt-0.5"></p>
      </div>
    </div>

    <!-- Loading State -->
    <div id="analytics-loading" class="py-20 text-center flex flex-col items-center justify-center space-y-3">
      <div class="w-10 h-10 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin"></div>
      <p class="text-sm font-medium text-slate-500">Menganalisis statistik tiket & beban server...</p>
    </div>

    <!-- Main Content Container -->
    <div id="analytics-content" class="hidden space-y-8">
      <!-- 4 Summary Metric Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Total Tickets All Time -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-xs relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Tiket Sistem</span>
            <div class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
              </svg>
            </div>
          </div>
          <div class="mt-4 flex items-baseline justify-between">
            <span id="stat-total-tickets-all-time" class="text-3xl font-extrabold text-slate-900 tracking-tight">-</span>
            <span class="text-xs text-slate-400 font-medium">All-time</span>
          </div>
        </div>

        <!-- Total Tickets Today -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-xs relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tiket Hari Ini</span>
            <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          </div>
          <div class="mt-4 flex items-baseline justify-between">
            <span id="stat-total-tickets-today" class="text-3xl font-extrabold text-blue-600 tracking-tight">-</span>
            <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-blue-50 text-blue-700">Live Traffic</span>
          </div>
        </div>

        <!-- Total Tickets Yesterday & Diff -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-xs relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tiket Kemarin</span>
            <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
          </div>
          <div class="mt-4 flex items-baseline justify-between">
            <span id="stat-total-tickets-yesterday" class="text-3xl font-extrabold text-slate-800 tracking-tight">-</span>
            <span id="stat-diff-badge" class="text-xs font-bold px-2 py-0.5 rounded-md bg-slate-100 text-slate-700">0%</span>
          </div>
        </div>

        <!-- Average Serving Time -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-xs relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Rata-Rata Layanan</span>
            <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
          </div>
          <div class="mt-4 flex items-baseline justify-between">
            <span id="stat-avg-serving-time" class="text-3xl font-extrabold text-emerald-600 tracking-tight">-</span>
            <span class="text-xs text-slate-400 font-medium">Per tiket</span>
          </div>
        </div>
      </div>

      <!-- Daily Barchart Section -->
      <div id="chart-daily-tickets-container" class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-100 pb-4">
          <div>
            <h2 class="text-base font-bold text-slate-900">Distribusi Tiket Harian (14 Hari Terakhir)</h2>
            <p class="text-xs text-slate-500 mt-0.5">
              Tren volume tiket harian di seluruh instansi untuk estimasi beban komputasi & basis data.
            </p>
          </div>
          <div class="flex items-center space-x-4 text-xs font-medium text-slate-500">
            <div class="flex items-center space-x-1.5">
              <span class="w-3 h-3 rounded-xs bg-indigo-600 inline-block"></span>
              <span>Total Tiket</span>
            </div>
            <div class="flex items-center space-x-1.5">
              <span class="w-3 h-3 rounded-xs bg-emerald-500 inline-block"></span>
              <span>Tiket Selesai</span>
            </div>
          </div>
        </div>

        <!-- Barchart Component Canvas -->
        <div class="relative pt-4">
          <div id="chart-daily-tickets" class="h-64 flex items-end justify-between gap-1 sm:gap-2 pt-8 pb-6 border-b border-slate-200">
            <!-- Dynamically generated bars -->
          </div>

          <div id="chart-labels" class="flex justify-between text-[10px] text-slate-400 font-mono pt-2">
            <!-- Dynamically generated date labels -->
          </div>
        </div>
      </div>

      <!-- Top 10 Tenants Section -->
      <div id="table-top-tenants" class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-100 pb-4">
          <div>
            <h2 class="text-base font-bold text-slate-900">Top 10 Tenant Teraktif (Load Estimasi Server)</h2>
            <p class="text-xs text-slate-500 mt-0.5">
              Instansi dengan kontribusi throughput tiket terbesar pada server.
            </p>
          </div>

          <!-- Tab Switcher (Hari Ini vs Kemarin) -->
          <div class="inline-flex p-1 bg-slate-100 rounded-xl">
            <button
              id="tab-top-tenants-today"
              type="button"
              class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-indigo-700 shadow-xs cursor-pointer transition-all"
            >
              Hari Ini
            </button>
            <button
              id="tab-top-tenants-yesterday"
              type="button"
              class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 cursor-pointer transition-all"
            >
              Kemarin
            </button>
          </div>
        </div>

        <!-- Table Container: Today -->
        <div id="table-container-today" class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 pb-3">
                <th class="py-3 px-3 w-16">Peringkat</th>
                <th class="py-3 px-3">Instansi Tenant</th>
                <th class="py-3 px-3">Status</th>
                <th class="py-3 px-3 text-right">Tiket Diterbitkan</th>
                <th class="py-3 px-3 w-48">Beban Server (% Share)</th>
                <th class="py-3 px-3 text-center w-24">Aksi</th>
              </tr>
            </thead>
            <tbody id="tbody-top-tenants-today" class="divide-y divide-slate-100">
              <!-- Dynamically populated -->
            </tbody>
          </table>
          <div id="empty-state-today" class="hidden py-8 text-center text-xs text-slate-400">
            Belum ada aktivitas tiket hari ini.
          </div>
        </div>

        <!-- Table Container: Yesterday -->
        <div id="table-container-yesterday" class="hidden overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 pb-3">
                <th class="py-3 px-3 w-16">Peringkat</th>
                <th class="py-3 px-3">Instansi Tenant</th>
                <th class="py-3 px-3">Status</th>
                <th class="py-3 px-3 text-right">Tiket Diterbitkan</th>
                <th class="py-3 px-3 w-48">Beban Server (% Share)</th>
                <th class="py-3 px-3 text-center w-24">Aksi</th>
              </tr>
            </thead>
            <tbody id="tbody-top-tenants-yesterday" class="divide-y divide-slate-100">
              <!-- Dynamically populated -->
            </tbody>
          </table>
          <div id="empty-state-yesterday" class="hidden py-8 text-center text-xs text-slate-400">
            Tidak ada aktivitas tiket yang tercatat kemarin.
          </div>
        </div>
      </div>
    </div>
  </div>
</PlatformLayout>

<script>
  import { getPlatformTicketAnalytics } from '../../services/platformService';
  import type { PlatformTicketAnalyticsResponse, PlatformTopTenantItem } from '../../types/platform.types';

  document.addEventListener('DOMContentLoaded', () => {
    const loadingEl = document.getElementById('analytics-loading');
    const contentEl = document.getElementById('analytics-content');
    const errorContainerEl = document.getElementById('analytics-error-container');
    const errorMessageEl = document.getElementById('analytics-error-message');
    const refreshBtn = document.getElementById('btn-refresh-analytics');
    const refreshIcon = document.getElementById('icon-refresh');

    const tabTodayBtn = document.getElementById('tab-top-tenants-today');
    const tabYesterdayBtn = document.getElementById('tab-top-tenants-yesterday');
    const tableTodayEl = document.getElementById('table-container-today');
    const tableYesterdayEl = document.getElementById('table-container-yesterday');

    const loadData = async () => {
      if (refreshIcon) refreshIcon.classList.add('animate-spin');
      if (errorContainerEl) errorContainerEl.classList.add('hidden');

      try {
        const res = await getPlatformTicketAnalytics(14);
        if (!res.success || !res.data) {
          throw new Error(res.error?.message || 'Gagal mengambil data analitik platform');
        }

        const data = res.data;
        renderSummary(data);
        renderDailyChart(data.daily_trend);
        renderTopTenants(data.top_tenants_today, 'tbody-top-tenants-today', 'empty-state-today');
        renderTopTenants(data.top_tenants_yesterday, 'tbody-top-tenants-yesterday', 'empty-state-yesterday');

        if (loadingEl) loadingEl.classList.add('hidden');
        if (contentEl) contentEl.classList.remove('hidden');
      } catch (err: any) {
        if (errorMessageEl) errorMessageEl.textContent = err.message || 'Terjadi kesalahan jaringan';
        if (errorContainerEl) errorContainerEl.classList.remove('hidden');
        if (loadingEl) loadingEl.classList.add('hidden');
      } finally {
        if (refreshIcon) refreshIcon.classList.remove('animate-spin');
      }
    };

    const renderSummary = (data: PlatformTicketAnalyticsResponse) => {
      const allTimeEl = document.getElementById('stat-total-tickets-all-time');
      const todayEl = document.getElementById('stat-total-tickets-today');
      const yesterdayEl = document.getElementById('stat-total-tickets-yesterday');
      const diffBadgeEl = document.getElementById('stat-diff-badge');
      const avgDurationEl = document.getElementById('stat-avg-serving-time');

      if (allTimeEl) allTimeEl.textContent = data.summary.total_tickets_all_time.toLocaleString('id-ID');
      if (todayEl) todayEl.textContent = data.summary.total_tickets_today.toLocaleString('id-ID');
      if (yesterdayEl) yesterdayEl.textContent = data.summary.total_tickets_yesterday.toLocaleString('id-ID');

      if (diffBadgeEl) {
        const diff = data.summary.diff_percentage;
        if (diff > 0) {
          diffBadgeEl.textContent = `+${diff}%`;
          diffBadgeEl.className = 'text-xs font-bold px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700';
        } else if (diff < 0) {
          diffBadgeEl.textContent = `${diff}%`;
          diffBadgeEl.className = 'text-xs font-bold px-2 py-0.5 rounded-md bg-rose-50 text-rose-700';
        } else {
          diffBadgeEl.textContent = `0%`;
          diffBadgeEl.className = 'text-xs font-bold px-2 py-0.5 rounded-md bg-slate-100 text-slate-700';
        }
      }

      if (avgDurationEl) {
        avgDurationEl.textContent = `${data.summary.avg_serving_time_mins} m`;
      }
    };

    const renderDailyChart = (trend: PlatformTicketAnalyticsResponse['daily_trend']) => {
      const chartEl = document.getElementById('chart-daily-tickets');
      const labelsEl = document.getElementById('chart-labels');
      if (!chartEl || !labelsEl) return;

      chartEl.innerHTML = '';
      labelsEl.innerHTML = '';

      if (!trend || trend.length === 0) return;

      const maxVal = Math.max(...trend.map((t) => t.total_tickets), 10);

      trend.forEach((item) => {
        const heightPct = Math.max((item.total_tickets / maxVal) * 100, 4);
        const completedHeightPct = item.total_tickets > 0 ? (item.completed_tickets / item.total_tickets) * 100 : 0;

        // Parse date string (YYYY-MM-DD) -> dd/mm
        const parts = item.date.split('-');
        const dateFormatted = parts.length === 3 ? `${parts[2]}/${parts[1]}` : item.date;

        const col = document.createElement('div');
        col.className = 'flex-1 flex flex-col items-center h-full justify-end group relative cursor-pointer';

        col.innerHTML = `
          <!-- Tooltip on hover -->
          <div class="absolute -top-12 z-20 hidden group-hover:flex flex-col items-center pointer-events-none transition-all">
            <div class="bg-slate-900 text-white text-[10px] py-1 px-2 rounded-lg shadow-xl whitespace-nowrap text-center">
              <p class="font-bold">${item.date}</p>
              <p class="text-indigo-300">Total: ${item.total_tickets}</p>
              <p class="text-emerald-400">Selesai: ${item.completed_tickets}</p>
            </div>
            <div class="w-2 h-2 bg-slate-900 rotate-45 -mt-1"></div>
          </div>

          <!-- Bar column -->
          <div class="w-full max-w-[28px] bg-slate-100 rounded-t-md overflow-hidden relative transition-all group-hover:bg-indigo-50" style="height: ${heightPct}%;">
            <div class="w-full bg-indigo-600 rounded-t-md transition-all absolute inset-0 group-hover:bg-indigo-500">
              <div class="w-full bg-emerald-500 absolute bottom-0" style="height: ${completedHeightPct}%;"></div>
            </div>
          </div>
        `;

        chartEl.appendChild(col);

        // Label
        const lbl = document.createElement('div');
        lbl.className = 'flex-1 text-center truncate';
        lbl.textContent = dateFormatted;
        labelsEl.appendChild(lbl);
      });
    };

    const renderTopTenants = (items: PlatformTopTenantItem[], tbodyId: string, emptyStateId: string) => {
      const tbody = document.getElementById(tbodyId);
      const emptyEl = document.getElementById(emptyStateId);
      if (!tbody || !emptyEl) return;

      tbody.innerHTML = '';

      if (!items || items.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }

      emptyEl.classList.add('hidden');

      items.forEach((tenant) => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50/80 transition-colors';

        let rankBadge = `<span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold bg-slate-100 text-slate-700">#${tenant.rank}</span>`;
        if (tenant.rank === 1) {
          rankBadge = `<span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-black bg-amber-100 text-amber-800 border border-amber-300">🥇</span>`;
        } else if (tenant.rank === 2) {
          rankBadge = `<span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-black bg-slate-200 text-slate-800 border border-slate-300">🥈</span>`;
        } else if (tenant.rank === 3) {
          rankBadge = `<span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-black bg-amber-50 text-amber-700 border border-amber-200">🥉</span>`;
        }

        let statusClass = 'bg-emerald-50 text-emerald-700 border-emerald-200';
        if (tenant.status === 'suspended') statusClass = 'bg-rose-50 text-rose-700 border-rose-200';
        if (tenant.status === 'trial') statusClass = 'bg-amber-50 text-amber-700 border-amber-200';

        tr.innerHTML = `
          <td class="py-3.5 px-3">${rankBadge}</td>
          <td class="py-3.5 px-3">
            <div class="font-semibold text-slate-900">${tenant.name}</div>
            <div class="text-xs text-slate-400 font-mono">${tenant.slug}</div>
          </td>
          <td class="py-3.5 px-3">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold border uppercase tracking-wider ${statusClass}">
              ${tenant.status}
            </span>
          </td>
          <td class="py-3.5 px-3 text-right font-bold text-slate-900">
            ${tenant.total_tickets.toLocaleString('id-ID')}
          </td>
          <td class="py-3.5 px-3">
            <div class="flex items-center space-x-2">
              <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                <div class="h-full bg-indigo-600 rounded-full" style="width: ${Math.min(tenant.percentage, 100)}%;"></div>
              </div>
              <span class="text-xs font-semibold text-slate-700 w-10 text-right">${tenant.percentage}%</span>
            </div>
          </td>
          <td class="py-3.5 px-3 text-center">
            <a
              href="/platform/tenants?search=${tenant.slug}"
              class="inline-flex items-center px-2.5 py-1 text-xs font-medium text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition-colors"
            >
              Kelola
            </a>
          </td>
        `;

        tbody.appendChild(tr);
      });
    };

    // Tab switching
    if (tabTodayBtn && tabYesterdayBtn && tableTodayEl && tableYesterdayEl) {
      tabTodayBtn.addEventListener('click', () => {
        tabTodayBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-indigo-700 shadow-xs cursor-pointer transition-all';
        tabYesterdayBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 cursor-pointer transition-all';
        tableTodayEl.classList.remove('hidden');
        tableYesterdayEl.classList.add('hidden');
      });

      tabYesterdayBtn.addEventListener('click', () => {
        tabYesterdayBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-indigo-700 shadow-xs cursor-pointer transition-all';
        tabTodayBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 cursor-pointer transition-all';
        tableYesterdayEl.classList.remove('hidden');
        tableTodayEl.classList.add('hidden');
      });
    }

    if (refreshBtn) {
      refreshBtn.addEventListener('click', loadData);
    }

    // Initial load
    loadData();
  });
</script>
