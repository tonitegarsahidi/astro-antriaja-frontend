---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Koneksi Terputus - AntriAja" description="Halaman Mode Offline AntriAja">
  <div class="min-h-screen bg-slate-100 flex flex-col justify-center items-center px-4 py-12 text-center">
    <div class="max-w-md w-full bg-white rounded-3xl p-8 border border-slate-200 shadow-lg space-y-6">
      <!-- Offline Graphic / Icon -->
      <div class="w-20 h-20 bg-amber-100 text-amber-600 rounded-3xl mx-auto flex items-center justify-center shadow-inner">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 4.243a1 1 0 010-1.414m0 0l-2.829-2.829m0 0L3 3m2.828 2.828a9 9 0 0112.728 0" />
        </svg>
      </div>

      <!-- Title & Context -->
      <div class="space-y-2">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">
          Status Jaringan Terputus
        </span>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">
          Koneksi Terputus
        </h1>
        <p class="text-xs text-slate-500 leading-relaxed">
          Perangkat Anda saat ini berjalan dalam <span class="font-semibold text-slate-700">mode offline</span>. Halaman yang belum tersimpan di cache lokal tidak dapat dimuat tanpa jaringan internet.
        </p>
      </div>

      <!-- Instructions -->
      <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 text-left text-xs text-slate-600 space-y-2">
        <div class="font-bold text-slate-800 flex items-center space-x-1.5">
          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Langkah Pemulihan:</span>
        </div>
        <ul class="list-disc list-inside space-y-1 text-[11px] text-slate-500">
          <li>Periksa koneksi Wi-Fi atau data seluler Anda.</li>
          <li>Pastikan backend server AntriAja dalam kondisi aktif.</li>
          <li>Sistem akan menyinkronkan data secara otomatis saat online.</li>
        </ul>
      </div>

      <!-- Action Buttons -->
      <div class="space-y-3 pt-2">
        <button
          id="btn-retry-connection"
          type="button"
          class="w-full flex items-center justify-center py-3 px-4 rounded-xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-md shadow-blue-600/20 transition-all cursor-pointer space-x-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Muat Ulang Halaman</span>
        </button>

        <a
          href="/"
          class="block w-full py-2.5 px-4 rounded-xl text-xs font-bold text-slate-600 hover:text-slate-900 bg-white hover:bg-slate-50 border border-slate-200 transition-colors"
        >
          Kembali ke Beranda
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initOfflinePage() {
    const retryBtn = document.getElementById('btn-retry-connection');
    if (retryBtn) {
      retryBtn.addEventListener('click', () => {
        retryBtn.textContent = 'Memeriksa koneksi...';
        window.location.reload();
      });
    }

    // Auto-reload when network reconnects
    window.addEventListener('online', () => {
      window.location.reload();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOfflinePage);
  } else {
    initOfflinePage();
  }
</script>
