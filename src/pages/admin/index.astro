---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard Administrator - AntriAja" activePage="dashboard">
  <div class="space-y-6">
    <!-- Header Page -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-slate-900 tracking-tight">
          Ringkasan Operasional Cabang
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Pantau status layanan, meja loket, dan antrian aktif secara real-time
        </p>
      </div>

      <div class="flex items-center space-x-2">
        <button
          id="btn-refresh-dashboard"
          type="button"
          class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-lg shadow-2xs transition-colors cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 mr-1 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Refresh Data</span>
        </button>
      </div>
    </div>

    <!-- Stat Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      <!-- Card 1: Total Services -->
      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs hover:shadow-md transition-all flex items-center space-x-4 relative overflow-hidden group">
        <div class="absolute top-0 left-0 right-0 h-1 bg-blue-500"></div>
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 border border-blue-100 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <div>
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Kategori Layanan</span>
          <span id="stat-services-count" class="text-2xl font-black text-slate-900 tracking-tight font-mono">--</span>
          <span class="text-[11px] text-slate-400 block mt-0.5">Layanan aktif cabang</span>
        </div>
      </div>

      <!-- Card 2: Total Counters -->
      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs hover:shadow-md transition-all flex items-center space-x-4 relative overflow-hidden group">
        <div class="absolute top-0 left-0 right-0 h-1 bg-indigo-500"></div>
        <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0 border border-indigo-100 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Meja Loket Fisik</span>
          <span id="stat-counters-count" class="text-2xl font-black text-slate-900 tracking-tight font-mono">--</span>
          <span class="text-[11px] text-slate-400 block mt-0.5">Unit loket terdaftar</span>
        </div>
      </div>

      <!-- Card 3: Staff on Duty -->
      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs hover:shadow-md transition-all flex items-center space-x-4 relative overflow-hidden group">
        <div class="absolute top-0 left-0 right-0 h-1 bg-emerald-500"></div>
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-100 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <div>
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Staf Bertugas</span>
          <span id="stat-staff-count" class="text-2xl font-black text-slate-900 tracking-tight font-mono">--</span>
          <span class="text-[11px] text-slate-400 block mt-0.5">Menjaga loket saat ini</span>
        </div>
      </div>

      <!-- Card 4: Waiting Tickets -->
      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs hover:shadow-md transition-all flex items-center space-x-4 relative overflow-hidden group">
        <div class="absolute top-0 left-0 right-0 h-1 bg-amber-500"></div>
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 border border-amber-100 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Tiket Menunggu</span>
          <span id="stat-waiting-count" class="text-2xl font-black text-amber-600 tracking-tight font-mono">--</span>
          <span class="text-[11px] text-slate-400 block mt-0.5">Antrian aktif di ruang tunggu</span>
        </div>
      </div>
    </div>

    <!-- Quick Navigation Modules -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between group">
        <div>
          <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center mb-3 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900">Kelola Layanan</h3>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">Tambah atau sesuaikan kategori layanan, prefix tiket (A/B), dan durasi layanan.</p>
        </div>
        <div class="pt-4 border-t border-slate-100 mt-4">
          <a
            href="/admin/services"
            class="inline-flex items-center text-xs font-bold text-blue-600 hover:text-blue-800 transition-colors"
          >
            <span>Buka Manajemen Layanan</span>
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between group">
        <div>
          <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center mb-3 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900">Kelola Meja Loket</h3>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">Atur meja loket fisik dan petakan jenis layanan (M:N) yang ditangani tiap loket.</p>
        </div>
        <div class="pt-4 border-t border-slate-100 mt-4">
          <a
            href="/admin/counters"
            class="inline-flex items-center text-xs font-bold text-indigo-600 hover:text-indigo-800 transition-colors"
          >
            <span>Buka Manajemen Loket</span>
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between group">
        <div>
          <div class="w-10 h-10 rounded-xl bg-violet-100 text-violet-600 flex items-center justify-center mb-3 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900">Konfigurasi Display TV</h3>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">Ubah teks berjalan (running text), banner promo/video, dan pairing display.</p>
        </div>
        <div class="pt-4 border-t border-slate-100 mt-4">
          <a
            href="/admin/display"
            class="inline-flex items-center text-xs font-bold text-violet-600 hover:text-violet-800 transition-colors"
          >
            <span>Buka Pengaturan Display TV</span>
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { listServices } from '../../services/serviceService';
  import { listCounters } from '../../services/counterService';

  async function loadDashboardStats() {
    const servicesEl = document.getElementById('stat-services-count');
    const countersEl = document.getElementById('stat-counters-count');
    const staffEl = document.getElementById('stat-staff-count');
    const waitingEl = document.getElementById('stat-waiting-count');

    try {
      const [servicesRes, countersRes] = await Promise.all([
        listServices(),
        listCounters(),
      ]);

      if (servicesRes.success && servicesRes.data && servicesEl) {
        servicesEl.textContent = String(servicesRes.data.length);
      }

      if (countersRes.success && countersRes.data) {
        if (countersEl) countersEl.textContent = String(countersRes.data.length);
        const occupied = countersRes.data.filter((c) => c.status !== 'idle' || c.current_staff_id != null).length;
        if (staffEl) staffEl.textContent = String(occupied);
      }

      if (waitingEl) {
        waitingEl.textContent = '0';
      }
    } catch (err) {
      console.error('Gagal memuat statistik dashboard:', err);
    }
  }

  function initDashboard() {
    loadDashboardStats();
    const refreshBtn = document.getElementById('btn-refresh-dashboard');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => loadDashboardStats());
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboard);
  } else {
    initDashboard();
  }
</script>
