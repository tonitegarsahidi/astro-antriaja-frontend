---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Laporan & Analitik Antrian" activePage="analytics">
  <div class="space-y-6">
    <!-- Header Section with Title and CSV Export -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-slate-900 tracking-tight">
          Laporan & Analitik Antrian
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Pantau performa operasional, jam sibuk, dan efisiensi staf loket cabang.
        </p>
      </div>

      <div class="flex items-center space-x-2">
        <button
          id="btn-export-csv"
          type="button"
          class="inline-flex items-center px-4 py-2 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-xs transition-all cursor-pointer space-x-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Ekspor CSV</span>
        </button>
      </div>
    </div>

    <!-- Date Filter Bar -->
    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <!-- Quick Presets -->
      <div class="flex items-center space-x-2">
        <span class="text-xs font-semibold text-slate-500 mr-1">Periode:</span>
        <button
          id="btn-preset-today"
          type="button"
          class="px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors cursor-pointer"
        >
          Hari Ini
        </button>
        <button
          id="btn-preset-7days"
          type="button"
          class="px-3 py-1.5 text-xs font-medium rounded-lg bg-blue-50 border border-blue-200 text-blue-600 font-semibold transition-colors cursor-pointer"
        >
          7 Hari Terakhir
        </button>
        <button
          id="btn-preset-30days"
          type="button"
          class="px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors cursor-pointer"
        >
          30 Hari Terakhir
        </button>
      </div>

      <!-- Custom Date Inputs -->
      <div class="flex items-center space-x-2">
        <div class="flex items-center space-x-1.5">
          <label for="input-start-date" class="text-xs font-medium text-slate-500">Dari:</label>
          <input
            id="input-start-date"
            type="date"
            class="px-2.5 py-1.5 text-xs rounded-lg border border-slate-200 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-transparent text-slate-700 font-mono"
          />
        </div>
        <div class="flex items-center space-x-1.5">
          <label for="input-end-date" class="text-xs font-medium text-slate-500">Sampai:</label>
          <input
            id="input-end-date"
            type="date"
            class="px-2.5 py-1.5 text-xs rounded-lg border border-slate-200 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-transparent text-slate-700 font-mono"
          />
        </div>
        <button
          id="btn-apply-date-filter"
          type="button"
          class="px-3.5 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-2xs transition-colors cursor-pointer"
        >
          Terapkan
        </button>
      </div>
    </div>

    <!-- Alert Message (Error / Warning) -->
    <div id="analytics-alert" class="hidden p-3.5 bg-rose-50 border border-rose-200 rounded-xl text-xs text-rose-700 font-medium"></div>

    <!-- 6 Metric Cards Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3.5 sm:gap-4">
      <!-- Card 1: Total Tiket -->
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Tiket</span>
          <div class="w-7 h-7 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
            </svg>
          </div>
        </div>
        <div class="mt-2">
          <span id="stat-total-tickets" class="text-2xl font-black text-slate-900 tracking-tight font-mono">--</span>
          <span class="text-[10px] text-slate-400 block">semua status</span>
        </div>
      </div>

      <!-- Card 2: Tiket Selesai -->
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Selesai</span>
          <div class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <div class="mt-2">
          <span id="stat-completed-tickets" class="text-2xl font-black text-emerald-600 tracking-tight font-mono">--</span>
          <span class="text-[10px] text-slate-400 block">terlayani tuntas</span>
        </div>
      </div>

      <!-- Card 3: Kadaluwarsa / Dibatalkan -->
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Kadaluwarsa</span>
          <div class="w-7 h-7 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <div class="mt-2">
          <span id="stat-expired-tickets" class="text-2xl font-black text-rose-600 tracking-tight font-mono">--</span>
          <span class="text-[10px] text-slate-400 block">tidak hadir / batal</span>
        </div>
      </div>

      <!-- Card 4: Avg Waktu Tunggu -->
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Avg Tunggu</span>
          <div class="w-7 h-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <div class="mt-2">
          <span id="stat-avg-wait-time" class="text-2xl font-black text-slate-900 tracking-tight font-mono">--</span>
          <span class="text-[10px] text-slate-400 block">kios ke loket</span>
        </div>
      </div>

      <!-- Card 5: Avg Waktu Pelayanan -->
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Avg Layan</span>
          <div class="w-7 h-7 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
        </div>
        <div class="mt-2">
          <span id="stat-avg-serve-time" class="text-2xl font-black text-slate-900 tracking-tight font-mono">--</span>
          <span class="text-[10px] text-slate-400 block">durasi di loket</span>
        </div>
      </div>

      <!-- Card 6: Tingkat Penyelesaian -->
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Tingkat Sukses</span>
          <div class="w-7 h-7 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
        </div>
        <div class="mt-2">
          <span id="stat-completion-rate" class="text-2xl font-black text-teal-600 tracking-tight font-mono">--</span>
          <span class="text-[10px] text-slate-400 block">rasio selesai</span>
        </div>
      </div>
    </div>

    <!-- Peak Hours 24-Hour Distribution Bar Chart -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-sm font-bold text-slate-800">Distribusi Jam Sibuk (24 Jam)</h3>
          <p class="text-[11px] text-slate-400 mt-0.5">Frekuensi kedatangan antrian per jam operasional</p>
        </div>
        <span id="peak-hours-date-label" class="text-xs font-medium text-slate-500 font-mono">Hari Ini</span>
      </div>

      <!-- Chart Container -->
      <div id="chart-peak-hours" class="w-full pt-4 pb-2">
        <div class="h-44 flex items-end justify-between gap-1 sm:gap-1.5 border-b border-slate-200 px-1">
          <!-- Bars dynamically injected by JS -->
          <div class="text-center w-full py-12 text-xs text-slate-400">Memuat data grafik...</div>
        </div>
        <!-- Hours Label Row -->
        <div id="chart-hours-labels" class="flex justify-between text-[10px] text-slate-400 font-mono mt-2 px-1">
          <span>00:00</span>
          <span>04:00</span>
          <span>08:00</span>
          <span>12:00</span>
          <span>16:00</span>
          <span>20:00</span>
          <span>23:00</span>
        </div>
      </div>
    </div>

    <!-- Grid 2 Tables: Services Breakdown & Staff Speed -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Table 1: Performa Kategori Layanan -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-2xs overflow-hidden flex flex-col">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
          <div>
            <h3 class="text-sm font-bold text-slate-800">Performa Kategori Layanan</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Statistik tiket dan efisiensi per departemen</p>
          </div>
        </div>

        <div class="overflow-x-auto flex-1">
          <table id="table-services-metrics" class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200/80 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                <th class="py-2.5 px-4">Layanan</th>
                <th class="py-2.5 px-3 text-center">Prefix</th>
                <th class="py-2.5 px-3 text-right">Total</th>
                <th class="py-2.5 px-3 text-right">Selesai</th>
                <th class="py-2.5 px-3 text-right">Avg Tunggu</th>
                <th class="py-2.5 px-3 text-right">Avg Layan</th>
                <th class="py-2.5 px-4 text-right">Tingkat Sukses</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs">
              <tr>
                <td colspan="7" class="py-8 text-center text-slate-400">Memuat data layanan...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Table 2: Kecepatan & Produktivitas Petugas Staf -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-2xs overflow-hidden flex flex-col">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
          <div>
            <h3 class="text-sm font-bold text-slate-800">Produktivitas Petugas Staf</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Jumlah tiket dilayani dan rata-rata kecepatan kerja</p>
          </div>
        </div>

        <div class="overflow-x-auto flex-1">
          <table id="table-staff-metrics" class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200/80 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                <th class="py-2.5 px-4">Petugas Staf</th>
                <th class="py-2.5 px-4">Email</th>
                <th class="py-2.5 px-3 text-right">Tiket Dilayani</th>
                <th class="py-2.5 px-4 text-right">Rata-rata Waktu Layan</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs">
              <tr>
                <td colspan="4" class="py-8 text-center text-slate-400">Memuat data staf...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import {
    getAnalyticsSummary,
    getPeakHours,
    getServiceMetrics,
    getStaffPerformance,
    exportAnalyticsCSV,
  } from '../../services/analyticsService';
  import type {
    AnalyticsSummaryResponse,
    PeakHourItem,
    ServiceAnalyticsItem,
    StaffAnalyticsItem,
  } from '../../types/analytics.types';

  // Helper untuk format tanggal lokal YYYY-MM-DD
  function toDateStr(d: Date): string {
    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  }

  // Helper format detik ke format waktu terbaca manusia
  function formatDuration(seconds: number): string {
    if (!seconds || seconds <= 0) return '0d';
    const totalSecs = Math.round(seconds);
    const mins = Math.floor(totalSecs / 60);
    const secs = totalSecs % 60;
    if (mins === 0) return `${secs}d`;
    if (secs === 0) return `${mins}m`;
    return `${mins}m ${secs}d`;
  }

  // State rentang tanggal saat ini
  const today = new Date();
  const defaultStartDate = new Date();
  defaultStartDate.setDate(today.getDate() - 6); // 7 hari terakhir default

  let currentStartDate = toDateStr(defaultStartDate);
  let currentEndDate = toDateStr(today);

  // Inisialisasi kontrol input tanggal
  const inputStartDate = document.getElementById('input-start-date') as HTMLInputElement | null;
  const inputEndDate = document.getElementById('input-end-date') as HTMLInputElement | null;
  const btnPresetToday = document.getElementById('btn-preset-today');
  const btnPreset7Days = document.getElementById('btn-preset-7days');
  const btnPreset30Days = document.getElementById('btn-preset-30days');
  const btnApplyDateFilter = document.getElementById('btn-apply-date-filter');
  const btnExportCSV = document.getElementById('btn-export-csv');
  const alertEl = document.getElementById('analytics-alert');

  function showAlert(message: string, isError = true) {
    if (!alertEl) return;
    alertEl.textContent = message;
    alertEl.className = isError
      ? 'p-3.5 bg-rose-50 border border-rose-200 rounded-xl text-xs text-rose-700 font-medium'
      : 'p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl text-xs text-emerald-700 font-medium';
    alertEl.classList.remove('hidden');
  }

  function hideAlert() {
    if (alertEl) alertEl.classList.add('hidden');
  }

  function setPresetButtonActive(activeBtn: HTMLElement | null) {
    [btnPresetToday, btnPreset7Days, btnPreset30Days].forEach((btn) => {
      if (!btn) return;
      if (btn === activeBtn) {
        btn.className =
          'px-3 py-1.5 text-xs font-semibold rounded-lg bg-blue-50 border border-blue-200 text-blue-600 transition-colors cursor-pointer';
      } else {
        btn.className =
          'px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors cursor-pointer';
      }
    });
  }

  // Render Metric Cards
  function renderMetrics(summary: AnalyticsSummaryResponse) {
    const elTotal = document.getElementById('stat-total-tickets');
    const elCompleted = document.getElementById('stat-completed-tickets');
    const elExpired = document.getElementById('stat-expired-tickets');
    const elAvgWait = document.getElementById('stat-avg-wait-time');
    const elAvgServe = document.getElementById('stat-avg-serve-time');
    const elCompletionRate = document.getElementById('stat-completion-rate');

    if (elTotal) elTotal.textContent = String(summary.total_tickets ?? 0);
    if (elCompleted) elCompleted.textContent = String(summary.completed_tickets ?? 0);
    if (elExpired) elExpired.textContent = String(summary.expired_tickets ?? 0);
    if (elAvgWait) elAvgWait.textContent = formatDuration(summary.avg_wait_seconds);
    if (elAvgServe) elAvgServe.textContent = formatDuration(summary.avg_serve_seconds);
    if (elCompletionRate) {
      const rate = summary.completion_rate !== undefined ? summary.completion_rate.toFixed(1) : '0.0';
      elCompletionRate.textContent = `${rate}%`;
    }
  }

  // Render Peak Hours Bar Chart (24 Jam)
  function renderPeakHours(hours: PeakHourItem[]) {
    const chartContainer = document.getElementById('chart-peak-hours');
    if (!chartContainer) return;

    // Pastikan terdapat 24 slot jam (0..23)
    const hourMap = new Map<number, number>();
    hours.forEach((h) => hourMap.set(h.hour, h.ticket_count));

    const maxCount = Math.max(...hours.map((h) => h.ticket_count), 1);

    const barsHtml = Array.from({ length: 24 }, (_, i) => {
      const count = hourMap.get(i) || 0;
      const heightPercent = count > 0 ? Math.max(Math.round((count / maxCount) * 100), 6) : 4;
      const isPeak = count === maxCount && count > 0;
      const barBg = isPeak ? 'bg-blue-600' : count > 0 ? 'bg-blue-400 hover:bg-blue-500' : 'bg-slate-100';

      const padHour = String(i).padStart(2, '0') + ':00';

      return `
        <div class="flex-1 flex flex-col items-center justify-end h-full group relative" title="${padHour}: ${count} tiket">
          <!-- Tooltip Hover -->
          <div class="absolute -top-7 opacity-0 group-hover:opacity-100 transition-opacity bg-slate-900 text-white text-[10px] font-mono px-1.5 py-0.5 rounded shadow pointer-events-none whitespace-nowrap z-10">
            ${padHour} (${count})
          </div>
          <!-- Bar -->
          <div class="w-full max-w-[28px] rounded-t-sm transition-all duration-300 ${barBg}" style="height: ${heightPercent}%;"></div>
        </div>
      `;
    }).join('');

    chartContainer.innerHTML = `
      <div class="h-44 flex items-end justify-between gap-1 sm:gap-1.5 border-b border-slate-200 px-1">
        ${barsHtml}
      </div>
      <div id="chart-hours-labels" class="flex justify-between text-[10px] text-slate-400 font-mono mt-2 px-1">
        <span>00:00</span>
        <span>04:00</span>
        <span>08:00</span>
        <span>12:00</span>
        <span>16:00</span>
        <span>20:00</span>
        <span>23:00</span>
      </div>
    `;
  }

  // Render Services Metrics Table
  function renderServicesTable(services: ServiceAnalyticsItem[]) {
    const tableEl = document.getElementById('table-services-metrics');
    if (!tableEl) return;
    const tbody = tableEl.querySelector('tbody');
    if (!tbody) return;

    if (!services || services.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-slate-400">Tidak ada data operasional layanan pada periode ini.</td></tr>`;
      return;
    }

    tbody.innerHTML = services
      .map(
        (s) => `
      <tr class="hover:bg-slate-50/70 transition-colors">
        <td class="py-3 px-4 font-semibold text-slate-800">${s.service_name}</td>
        <td class="py-3 px-3 text-center">
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold font-mono bg-slate-100 text-slate-700">
            ${s.service_prefix}
          </span>
        </td>
        <td class="py-3 px-3 text-right font-mono font-bold text-slate-700">${s.total_tickets}</td>
        <td class="py-3 px-3 text-right font-mono font-semibold text-emerald-600">${s.completed_tickets}</td>
        <td class="py-3 px-3 text-right font-mono text-slate-600">${formatDuration(s.avg_wait_seconds)}</td>
        <td class="py-3 px-3 text-right font-mono text-slate-600">${formatDuration(s.avg_serve_seconds)}</td>
        <td class="py-3 px-4 text-right font-mono font-bold text-teal-600">
          ${s.completion_rate !== undefined ? s.completion_rate.toFixed(1) : '0.0'}%
        </td>
      </tr>
    `
      )
      .join('');
  }

  // Render Staff Metrics Table
  function renderStaffTable(staffList: StaffAnalyticsItem[]) {
    const tableEl = document.getElementById('table-staff-metrics');
    if (!tableEl) return;
    const tbody = tableEl.querySelector('tbody');
    if (!tbody) return;

    if (!staffList || staffList.length === 0) {
      tbody.innerHTML = `<tr><td colspan="4" class="py-8 text-center text-slate-400">Tidak ada riwayat staf melayani tiket pada periode ini.</td></tr>`;
      return;
    }

    tbody.innerHTML = staffList
      .map(
        (st) => `
      <tr class="hover:bg-slate-50/70 transition-colors">
        <td class="py-3 px-4 font-semibold text-slate-800 flex items-center space-x-2.5">
          <div class="w-6 h-6 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center text-[10px] font-black uppercase">
            ${st.full_name ? st.full_name.charAt(0) : 'U'}
          </div>
          <span>${st.full_name || 'Petugas'}</span>
        </td>
        <td class="py-3 px-4 text-slate-500 font-mono text-[11px]">${st.email || '-'}</td>
        <td class="py-3 px-3 text-right font-mono font-bold text-blue-600">${st.total_served}</td>
        <td class="py-3 px-4 text-right font-mono font-medium text-slate-700">${formatDuration(st.avg_serve_seconds)}</td>
      </tr>
    `
      )
      .join('');
  }

  // Main Loader
  async function loadDashboardData() {
    hideAlert();

    const peakHoursLabel = document.getElementById('peak-hours-date-label');
    if (peakHoursLabel) peakHoursLabel.textContent = `${currentStartDate} s/d ${currentEndDate}`;

    try {
      const [summaryRes, peakRes, servicesRes, staffRes] = await Promise.all([
        getAnalyticsSummary(currentStartDate, currentEndDate),
        getPeakHours(currentEndDate),
        getServiceMetrics(currentStartDate, currentEndDate),
        getStaffPerformance(currentStartDate, currentEndDate),
      ]);

      if (summaryRes.success && summaryRes.data) {
        renderMetrics(summaryRes.data);
      }
      if (peakRes.success && peakRes.data) {
        renderPeakHours(peakRes.data);
      }
      if (servicesRes.success && servicesRes.data) {
        renderServicesTable(servicesRes.data);
      }
      if (staffRes.success && staffRes.data) {
        renderStaffTable(staffRes.data);
      }
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Gagal memuat data analitik';
      showAlert(msg, true);
    }
  }

  // Event Listeners
  function initEventListeners() {
    if (inputStartDate) inputStartDate.value = currentStartDate;
    if (inputEndDate) inputEndDate.value = currentEndDate;

    // Preset Today
    if (btnPresetToday) {
      btnPresetToday.addEventListener('click', () => {
        setPresetButtonActive(btnPresetToday);
        const t = toDateStr(new Date());
        currentStartDate = t;
        currentEndDate = t;
        if (inputStartDate) inputStartDate.value = currentStartDate;
        if (inputEndDate) inputEndDate.value = currentEndDate;
        loadDashboardData();
      });
    }

    // Preset 7 Days
    if (btnPreset7Days) {
      btnPreset7Days.addEventListener('click', () => {
        setPresetButtonActive(btnPreset7Days);
        const t = new Date();
        const s = new Date();
        s.setDate(t.getDate() - 6);
        currentStartDate = toDateStr(s);
        currentEndDate = toDateStr(t);
        if (inputStartDate) inputStartDate.value = currentStartDate;
        if (inputEndDate) inputEndDate.value = currentEndDate;
        loadDashboardData();
      });
    }

    // Preset 30 Days
    if (btnPreset30Days) {
      btnPreset30Days.addEventListener('click', () => {
        setPresetButtonActive(btnPreset30Days);
        const t = new Date();
        const s = new Date();
        s.setDate(t.getDate() - 29);
        currentStartDate = toDateStr(s);
        currentEndDate = toDateStr(t);
        if (inputStartDate) inputStartDate.value = currentStartDate;
        if (inputEndDate) inputEndDate.value = currentEndDate;
        loadDashboardData();
      });
    }

    // Custom Apply Button
    if (btnApplyDateFilter) {
      btnApplyDateFilter.addEventListener('click', () => {
        if (!inputStartDate || !inputEndDate) return;
        const sVal = inputStartDate.value;
        const eVal = inputEndDate.value;
        if (!sVal || !eVal) {
          showAlert('Silakan pilih rentang tanggal mulai dan tanggal akhir dengan lengkap.');
          return;
        }
        if (sVal > eVal) {
          showAlert('Tanggal mulai tidak boleh lebih besar dari tanggal akhir.');
          return;
        }
        setPresetButtonActive(null);
        currentStartDate = sVal;
        currentEndDate = eVal;
        loadDashboardData();
      });
    }

    // Export CSV Download
    if (btnExportCSV) {
      btnExportCSV.addEventListener('click', async () => {
        const origText = btnExportCSV.innerHTML;
        btnExportCSV.setAttribute('disabled', 'true');
        btnExportCSV.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Mengunduh...</span>
        `;

        try {
          const csvData = await exportAnalyticsCSV(currentStartDate, currentEndDate);
          const blob = new Blob([csvData], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.setAttribute('download', `laporan-antrian-${currentStartDate}-sd-${currentEndDate}.csv`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(url);
          showAlert('Laporan analitik CSV berhasil diunduh.', false);
        } catch (err: unknown) {
          const msg = err instanceof Error ? err.message : 'Gagal mengekspor CSV';
          showAlert(msg, true);
        } finally {
          btnExportCSV.removeAttribute('disabled');
          btnExportCSV.innerHTML = origText;
        }
      });
    }

    // First load
    loadDashboardData();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEventListeners);
  } else {
    initEventListeners();
  }
</script>
