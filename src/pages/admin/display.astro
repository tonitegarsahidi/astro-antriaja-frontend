---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Pengaturan Display TV - AntriAja" activePage="display">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-slate-900 tracking-tight">
          Pengaturan Tampilan Smart TV
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Konfigurasikan teks berjalan, media promosi/video, dan panggilan suara untuk layar monitor ruang tunggu
        </p>
      </div>

      <div>
        <a
          id="link-open-tv"
          href="/display"
          target="_blank"
          class="inline-flex items-center px-4 py-2 text-xs font-bold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-xl shadow-2xs transition-all space-x-1.5"
        >
          <span>Buka Layar Display TV</span>
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Alert / Toast Banner -->
    <div id="display-page-alert" class="hidden p-4 rounded-xl text-xs font-semibold"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Form Settings (7 cols) -->
      <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200 shadow-2xs p-6">
        <form id="display-settings-form" class="space-y-5">
          <!-- Running Text -->
          <div>
            <label for="input-running-text" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
              Teks Berjalan (Running Text)
            </label>
            <textarea
              id="input-running-text"
              name="running_text"
              rows="3"
              placeholder="Selamat datang di cabang kami. Harap menunggu dengan tertib sesuai nomor antrian Anda."
              class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
            ></textarea>
            <p class="text-[11px] text-slate-400 mt-1">
              Pesan informasi yang akan berjalan di bagian bawah layar Smart TV secara berulang.
            </p>
          </div>

          <!-- Media Type & URL -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="select-media-type" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                Tipe Media Promosi
              </label>
              <select
                id="select-media-type"
                name="media_type"
                class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white"
              >
                <option value="none">Tanpa Media (Kosong)</option>
                <option value="image">Gambar Banner (Poster/Promo)</option>
                <option value="video">Video Loop (MP4/WebM)</option>
              </select>
            </div>

            <div>
              <label for="input-media-url" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                URL Media
              </label>
              <input
                id="input-media-url"
                name="media_url"
                type="url"
                placeholder="https://example.com/banner.jpg"
                class="w-full px-3.5 py-2 text-xs rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
              />
            </div>
          </div>

          <!-- Voice & Audio Configuration Section -->
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs font-bold text-slate-800">Panggilan Suara Audio (TTS)</span>
                <p class="text-[11px] text-slate-500">
                  Memutar notifikasi suara bell chime dan pembacaan nomor antrian pada speaker TV
                </p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input
                  id="toggle-voice-enabled"
                  name="voice_enabled"
                  type="checkbox"
                  checked
                  class="sr-only peer"
                />
                <div class="w-11 h-6 bg-slate-300 peer-focus:outline-hidden rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>

            <!-- Detail Pengaturan Audio & Bel Chime -->
            <div id="audio-settings-details" class="pt-3 border-t border-slate-200/80 space-y-3.5">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label for="select-bell-sound" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1">
                    Bunyi Bell (Chime)
                  </label>
                  <select
                    id="select-bell-sound"
                    name="bell_sound"
                    class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500 font-medium"
                  >
                    <option value="ding_dong">Klasik (Ding-Dong 2-Nada)</option>
                    <option value="tri_tone">Modern (Tri-Tone 3-Nada)</option>
                    <option value="airport">Bandara / Intercom (4-Nada Melodis)</option>
                    <option value="single_ting">Lonceng Tunggal (Elevator Ding)</option>
                    <option value="soft_pulse">Klinik / RS (Soft Sine)</option>
                    <option value="marimba">Bank / Pelayanan (Marimba Chime)</option>
                    <option value="none">Tanpa Bel (Hanya Suara)</option>
                  </select>
                </div>

                <div>
                  <label for="select-voice-lang" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1">
                    Bahasa Panggilan
                  </label>
                  <select
                    id="select-voice-lang"
                    name="voice_lang"
                    class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500 font-medium"
                  >
                    <option value="id-ID">Bahasa Indonesia (id-ID)</option>
                    <option value="en-US">English (en-US)</option>
                  </select>
                </div>

                <div>
                  <label for="select-voice-gender" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1">
                    Karakter Suara (TTS)
                  </label>
                  <select
                    id="select-voice-gender"
                    name="voice_gender"
                    class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500 font-medium"
                  >
                    <option value="female">Perempuan (Wanita)</option>
                    <option value="male">Laki-laki (Pria)</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                <div class="p-2.5 bg-white rounded-lg border border-slate-200">
                  <div class="flex items-center justify-between mb-1">
                    <label for="input-voice-pitch" class="text-[11px] font-bold text-slate-700">
                      Nada Suara (Pitch)
                    </label>
                    <span id="val-voice-pitch" class="text-[11px] font-mono font-bold text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">1.00x</span>
                  </div>
                  <input
                    id="input-voice-pitch"
                    name="voice_pitch"
                    type="range"
                    min="0.5"
                    max="1.5"
                    step="0.05"
                    value="1.0"
                    class="w-full accent-blue-600 cursor-pointer"
                  />
                  <div class="flex justify-between text-[9px] text-slate-400 mt-0.5 font-medium">
                    <span>Rendah (0.5x)</span>
                    <span>Standar (1.0x)</span>
                    <span>Tinggi (1.5x)</span>
                  </div>
                </div>

                <div class="p-2.5 bg-white rounded-lg border border-slate-200">
                  <div class="flex items-center justify-between mb-1">
                    <label for="input-voice-rate" class="text-[11px] font-bold text-slate-700">
                      Kecepatan / Tempo
                    </label>
                    <span id="val-voice-rate" class="text-[11px] font-mono font-bold text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">0.90x</span>
                  </div>
                  <input
                    id="input-voice-rate"
                    name="voice_rate"
                    type="range"
                    min="0.7"
                    max="1.3"
                    step="0.05"
                    value="0.9"
                    class="w-full accent-blue-600 cursor-pointer"
                  />
                  <div class="flex justify-between text-[9px] text-slate-400 mt-0.5 font-medium">
                    <span>Lambat (0.7x)</span>
                    <span>Standar (0.9x)</span>
                    <span>Cepat (1.3x)</span>
                  </div>
                </div>
              </div>

              <div class="flex items-center justify-between pt-1">
                <span class="text-[11px] text-slate-500">Pratinjau langsung audio speaker sebelum disimpan:</span>
                <button
                  id="btn-test-audio"
                  type="button"
                  class="px-3.5 py-1.5 text-xs font-bold text-blue-700 bg-blue-100/70 hover:bg-blue-100 border border-blue-200 rounded-lg transition-colors cursor-pointer flex items-center gap-1.5 shadow-2xs"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                  </svg>
                  <span>Uji Suara Panggilan</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Display Device Key Section (Terintegrasi di bawah TTS) -->
          <div class="p-4 bg-amber-50/50 rounded-xl border border-amber-200/70 space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <div class="w-7 h-7 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs font-bold text-slate-800">Display Device Key</span>
                  <span class="block text-[10px] text-slate-500">Kunci otentikasi wajib untuk menghubungkan layar Smart TV</span>
                </div>
              </div>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-300">
                Otorisasi TV
              </span>
            </div>

            <div class="space-y-1.5">
              <label for="input-display-device-key" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide">
                Device Key Layar TV:
              </label>
              <div class="flex items-center gap-2">
                <input
                  id="input-display-device-key"
                  type="text"
                  placeholder="Memuat display key..."
                  class="flex-1 px-3 py-2 text-xs font-mono rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white"
                />
                <button
                  id="btn-copy-device-key"
                  type="button"
                  title="Salin ke clipboard"
                  class="px-3 py-2 text-xs font-bold text-slate-700 bg-white hover:bg-slate-100 border border-slate-300 rounded-xl transition-colors cursor-pointer flex items-center gap-1 shrink-0"
                >
                  <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <span>Salin</span>
                </button>
              </div>
            </div>

            <div class="flex items-center justify-between pt-2 border-t border-amber-200/60">
              <span class="text-[11px] text-slate-500">Pasangkan langsung ke browser lokal ini:</span>
              <button
                id="btn-save-device-key"
                type="button"
                class="px-3.5 py-1.5 text-xs font-bold text-blue-700 bg-white hover:bg-blue-50 border border-blue-200 rounded-lg shadow-2xs transition-colors cursor-pointer"
              >
                Simpan di Browser
              </button>
            </div>
          </div>

          <!-- Error Alert -->
          <div id="display-form-error" class="hidden text-xs font-semibold text-rose-600 bg-rose-50 p-2.5 rounded-lg border border-rose-200"></div>

          <!-- Action Save -->
          <div class="pt-3 border-t border-slate-100 flex items-center justify-end">
            <button
              id="btn-save-display-settings"
              type="submit"
              class="px-5 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-xs hover:shadow-md transition-all cursor-pointer flex items-center space-x-1.5"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Simpan Pengaturan Display</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Live Preview Card (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-2xs p-5">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 flex items-center space-x-1.5">
            <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <span>Live Preview Layar TV</span>
          </h3>

          <div
            id="display-preview-card"
            class="w-full aspect-video bg-slate-900 rounded-xl overflow-hidden border border-slate-800 flex flex-col justify-between p-3 relative shadow-inner text-white"
          >
            <!-- Simulated Top Bar -->
            <div class="flex items-center justify-between border-b border-slate-800/80 pb-2">
              <span class="text-[10px] font-black tracking-tight text-blue-400">AntriAja Display</span>
              <span class="text-[9px] font-mono text-slate-400">12:00:00</span>
            </div>

            <!-- Simulated Main Area -->
            <div class="flex-1 flex items-center justify-center py-3">
              <div id="preview-media-container" class="text-center text-slate-500 text-[11px] italic">
                (Area Media Promosi / Nomor Panggilan)
              </div>
            </div>

            <!-- Simulated Bottom Running Text Bar -->
            <div class="bg-blue-950/80 border border-blue-900/60 rounded-md p-1.5 overflow-hidden">
              <p id="preview-running-text" class="text-[10px] text-blue-200 whitespace-nowrap overflow-hidden text-ellipsis">
                Selamat datang di AntriAja...
              </p>
            </div>
          </div>

          <div class="mt-4 p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs space-y-1">
            <span class="font-bold text-slate-700 block">Sinkronisasi Realtime:</span>
            <p class="text-[11px] text-slate-500">
              Perubahan konfigurasi akan secara otomatis disiarkan langsung ke seluruh layar Smart TV yang sedang aktif via SSE tanpa perlu refresh manual.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import {
    getDisplaySettings,
    updateDisplaySettings,
  } from '../../services/displayService';
  import { getMe } from '../../services/authService';
  import { getTenantSlug, getDeviceKey, setDeviceKey } from '../../lib/storage';
  import type { MediaType, BellSoundType, VoiceLanguage, VoiceGender } from '../../types/display.types';
  import { globalAudioEngine, buildSpeechText } from '../../lib/audioPlayer';

  const form = document.getElementById('display-settings-form') as HTMLFormElement | null;
  const runningTextInput = document.getElementById('input-running-text') as HTMLTextAreaElement | null;
  const mediaTypeSelect = document.getElementById('select-media-type') as HTMLSelectElement | null;
  const mediaUrlInput = document.getElementById('input-media-url') as HTMLInputElement | null;
  const voiceToggle = document.getElementById('toggle-voice-enabled') as HTMLInputElement | null;
  const submitBtn = document.getElementById('btn-save-display-settings') as HTMLButtonElement | null;
  const errorEl = document.getElementById('display-form-error');

  const bellSoundSelect = document.getElementById('select-bell-sound') as HTMLSelectElement | null;
  const voiceLangSelect = document.getElementById('select-voice-lang') as HTMLSelectElement | null;
  const voiceGenderSelect = document.getElementById('select-voice-gender') as HTMLSelectElement | null;
  const voicePitchInput = document.getElementById('input-voice-pitch') as HTMLInputElement | null;
  const voiceRateInput = document.getElementById('input-voice-rate') as HTMLInputElement | null;
  const valPitchText = document.getElementById('val-voice-pitch');
  const valRateText = document.getElementById('val-voice-rate');
  const btnTestAudio = document.getElementById('btn-test-audio');
  const audioDetails = document.getElementById('audio-settings-details');

  const deviceKeyInput = document.getElementById('input-display-device-key') as HTMLInputElement | null;
  const btnCopyKey = document.getElementById('btn-copy-device-key');
  const btnSaveKey = document.getElementById('btn-save-device-key');

  const previewRunningText = document.getElementById('preview-running-text');
  const previewMedia = document.getElementById('preview-media-container');

  function updateLivePreview() {
    if (previewRunningText && runningTextInput) {
      previewRunningText.textContent = runningTextInput.value.trim() || 'Selamat datang di AntriAja...';
    }

    if (previewMedia && mediaTypeSelect && mediaUrlInput) {
      const type = mediaTypeSelect.value;
      const url = mediaUrlInput.value.trim();

      if (type === 'image' && url) {
        previewMedia.innerHTML = `<img src="${url}" alt="Preview" class="max-h-24 max-w-full rounded object-contain mx-auto" onerror="this.outerHTML='<span class=\\'text-rose-400 text-[10px]\\'>Gagal memuat URL gambar</span>'"/>`;
      } else if (type === 'video' && url) {
        previewMedia.innerHTML = `<span class="text-blue-400 text-[10px] font-semibold">Video: ${url}</span>`;
      } else {
        previewMedia.innerHTML = '<span class="text-slate-500 text-[11px] italic">(Area Media Promosi / Nomor Panggilan)</span>';
      }
    }
  }

  async function loadDisplaySettings() {
    try {
      const res = await getDisplaySettings();
      if (res.success && res.data) {
        const d = res.data;
        if (runningTextInput) runningTextInput.value = d.running_text || '';
        if (mediaTypeSelect) mediaTypeSelect.value = d.media_type || 'none';
        if (mediaUrlInput) mediaUrlInput.value = d.media_url || '';
        if (voiceToggle) voiceToggle.checked = d.voice_enabled ?? true;

        if (bellSoundSelect && d.bell_sound) bellSoundSelect.value = d.bell_sound;
        if (voiceLangSelect && d.voice_lang) voiceLangSelect.value = d.voice_lang;
        if (voiceGenderSelect && d.voice_gender) voiceGenderSelect.value = d.voice_gender;
        if (voicePitchInput && d.voice_pitch) {
          voicePitchInput.value = d.voice_pitch.toString();
          if (valPitchText) valPitchText.textContent = `${Number(d.voice_pitch).toFixed(2)}x`;
        }
        if (voiceRateInput && d.voice_rate) {
          voiceRateInput.value = d.voice_rate.toString();
          if (valRateText) valRateText.textContent = `${Number(d.voice_rate).toFixed(2)}x`;
        }

        if (audioDetails && voiceToggle) {
          if (voiceToggle.checked) {
            audioDetails.classList.remove('opacity-40', 'pointer-events-none');
          } else {
            audioDetails.classList.add('opacity-40', 'pointer-events-none');
          }
        }

        updateLivePreview();
      }
    } catch (err) {
      console.error('Gagal memuat display settings:', err);
    }

    // Load Display Device Key from getMe() or localStorage
    let activeKey = getDeviceKey('display') || '';
    try {
      const meRes = await getMe();
      if (meRes.success && meRes.data?.tenant?.display_key) {
        activeKey = meRes.data.tenant.display_key;
        setDeviceKey('display', activeKey);
      }
    } catch (e) {
      console.warn('Gagal memuat profil tenant:', e);
    }

    if (deviceKeyInput) {
      deviceKeyInput.value = activeKey;
    }

    // Set TV link query slug & device_key
    const tvLink = document.getElementById('link-open-tv') as HTMLAnchorElement | null;
    const slug = getTenantSlug();
    if (tvLink && slug) {
      tvLink.href = `/display?slug=${encodeURIComponent(slug)}${activeKey ? `&device_key=${encodeURIComponent(activeKey)}` : ''}`;
    }
  }

  function showAlert(msg: string, type: 'success' | 'error') {
    const alertEl = document.getElementById('display-page-alert');
    if (!alertEl) return;
    alertEl.textContent = msg;
    alertEl.className = `p-4 rounded-xl text-xs font-semibold ${
      type === 'success'
        ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
        : 'bg-rose-50 text-rose-800 border border-rose-200'
    }`;
    alertEl.classList.remove('hidden');
    setTimeout(() => {
      alertEl.classList.add('hidden');
    }, 5000);
  }

  function initDisplayPage() {
    loadDisplaySettings();

    if (runningTextInput) runningTextInput.addEventListener('input', updateLivePreview);
    if (mediaTypeSelect) mediaTypeSelect.addEventListener('change', updateLivePreview);
    if (mediaUrlInput) mediaUrlInput.addEventListener('input', updateLivePreview);

    voicePitchInput?.addEventListener('input', () => {
      if (valPitchText && voicePitchInput) {
        valPitchText.textContent = `${parseFloat(voicePitchInput.value).toFixed(2)}x`;
      }
    });

    voiceRateInput?.addEventListener('input', () => {
      if (valRateText && voiceRateInput) {
        valRateText.textContent = `${parseFloat(voiceRateInput.value).toFixed(2)}x`;
      }
    });

    voiceToggle?.addEventListener('change', () => {
      if (audioDetails && voiceToggle) {
        if (voiceToggle.checked) {
          audioDetails.classList.remove('opacity-40', 'pointer-events-none');
        } else {
          audioDetails.classList.add('opacity-40', 'pointer-events-none');
        }
      }
    });

    btnTestAudio?.addEventListener('click', async () => {
      if (!btnTestAudio) return;
      const testBell = (bellSoundSelect?.value || 'ding_dong') as BellSoundType;
      const testLang = (voiceLangSelect?.value || 'id-ID') as VoiceLanguage;
      const testGender = (voiceGenderSelect?.value || 'female') as VoiceGender;
      const testPitch = parseFloat(voicePitchInput?.value || '1.0');
      const testRate = parseFloat(voiceRateInput?.value || '0.9');

      const origHtml = btnTestAudio.innerHTML;
      btnTestAudio.setAttribute('disabled', 'true');
      btnTestAudio.innerHTML = `
        <svg class="w-3.5 h-3.5 animate-spin" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span>Memutar Suara...</span>
      `;

      try {
        globalAudioEngine.configureAudio({
          bellSound: testBell,
          voiceLang: testLang,
          voiceGender: testGender,
          voicePitch: testPitch,
          voiceRate: testRate,
        });

        await globalAudioEngine.unlock();
        await globalAudioEngine.playChime(testBell);
        const sampleInstruction = { prefix: 'A', number: 12, counter_number: 1 };
        const phrase = buildSpeechText(sampleInstruction, testLang);
        await globalAudioEngine.speakText(phrase);
      } catch (err) {
        console.warn('Uji suara error:', err);
      } finally {
        btnTestAudio.removeAttribute('disabled');
        btnTestAudio.innerHTML = origHtml;
      }
    });

    btnCopyKey?.addEventListener('click', async () => {
      if (!deviceKeyInput) return;
      const keyVal = deviceKeyInput.value.trim();
      if (!keyVal) return;
      try {
        await navigator.clipboard.writeText(keyVal);
        showAlert('Display Device Key berhasil disalin ke clipboard', 'success');
      } catch {
        showAlert('Gagal menyalin ke clipboard', 'error');
      }
    });

    btnSaveKey?.addEventListener('click', () => {
      if (!deviceKeyInput) return;
      const keyVal = deviceKeyInput.value.trim();
      if (!keyVal) {
        showAlert('Device key tidak boleh kosong', 'error');
        return;
      }
      setDeviceKey('display', keyVal);
      const slug = getTenantSlug();
      const tvLink = document.getElementById('link-open-tv') as HTMLAnchorElement | null;
      if (tvLink && slug) {
        tvLink.href = `/display?slug=${encodeURIComponent(slug)}&device_key=${encodeURIComponent(keyVal)}`;
      }
      showAlert('Display Device Key berhasil disimpan ke storage browser', 'success');
    });

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!runningTextInput || !mediaTypeSelect || !mediaUrlInput || !voiceToggle || !submitBtn) return;

        submitBtn.disabled = true;
        submitBtn.textContent = 'Menyimpan...';
        if (errorEl) errorEl.classList.add('hidden');

        try {
          const res = await updateDisplaySettings({
            running_text: runningTextInput.value.trim(),
            media_type: mediaTypeSelect.value as MediaType,
            media_url: mediaUrlInput.value.trim() || null,
            voice_enabled: voiceToggle.checked,
            bell_sound: (bellSoundSelect?.value || 'ding_dong') as BellSoundType,
            voice_lang: (voiceLangSelect?.value || 'id-ID') as VoiceLanguage,
            voice_gender: (voiceGenderSelect?.value || 'female') as VoiceGender,
            voice_pitch: parseFloat(voicePitchInput?.value || '1.0'),
            voice_rate: parseFloat(voiceRateInput?.value || '0.9'),
          });

          if (res.success) {
            showAlert('Pengaturan tampilan Smart TV berhasil diperbarui', 'success');
            updateLivePreview();
          } else {
            if (errorEl) {
              errorEl.textContent = res.error?.message || 'Gagal menyimpan pengaturan display';
              errorEl.classList.remove('hidden');
            }
          }
        } catch (err: unknown) {
          if (errorEl) {
            errorEl.textContent = 'Koneksi ke server gagal.';
            errorEl.classList.remove('hidden');
          }
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Simpan Pengaturan Display';
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDisplayPage);
  } else {
    initDisplayPage();
  }
</script>
