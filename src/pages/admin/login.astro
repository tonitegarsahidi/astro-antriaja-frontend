---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Login Administrator - AntriAja" description="Masuk ke Panel Administrasi Cabang AntriAja">
  <div class="min-h-screen bg-slate-100 flex flex-col justify-center py-6 sm:py-12 px-4 sm:px-6 lg:px-8">
    <!-- Main Card Shell with Split Layout on Large Screens -->
    <div class="mx-auto w-full max-w-4xl bg-white rounded-3xl shadow-xl border border-slate-200/80 overflow-hidden grid grid-cols-1 lg:grid-cols-12 min-h-[580px]">
      
      <!-- Left Hero Panel (Administrator Enterprise Branding) -->
      <div class="lg:col-span-5 bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 p-8 sm:p-10 text-white flex flex-col justify-between relative overflow-hidden">
        <!-- Subtle Background Elements -->
        <div class="absolute -top-16 -left-16 w-48 h-48 rounded-full bg-amber-400/10 blur-2xl pointer-events-none"></div>
        <div class="absolute -bottom-16 -right-16 w-56 h-56 rounded-full bg-indigo-500/20 blur-3xl pointer-events-none"></div>

        <div class="relative z-10 space-y-6">
          <!-- Brand Logo -->
          <a href="/" class="inline-flex items-center space-x-2 text-white font-black text-2xl tracking-tight group">
            <div class="w-10 h-10 rounded-xl bg-white/15 border border-white/25 flex items-center justify-center backdrop-blur-xs group-hover:bg-white/25 transition-all">
              <svg class="w-6 h-6 text-amber-400" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M17 20H7C4.79086 20 3 18.2091 3 16V8C3 5.79086 4.79086 4 7 4H17C19.2091 4 21 5.79086 21 8V16C21 18.2091 19.2091 20 17 20Z" stroke="currentColor" stroke-width="2"/>
                <path d="M7 10L10 13L17 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span>AntriAja</span>
          </a>

          <!-- Hero Pitch -->
          <div class="space-y-2 pt-4">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold tracking-widest bg-amber-500/20 border border-amber-400/30 text-amber-300 uppercase">
              PANEL ADMINISTRATOR
            </span>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white leading-tight">
              Kontrol Penuh Sistem Antrian Cabang
            </h1>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Konfigurasi kategori layanan, penugasan loket fleksibel, running text TV display, dan reset operasional harian.
            </p>
          </div>

          <!-- Feature Bullets -->
          <div class="space-y-2.5 pt-2 text-xs text-slate-300">
            <div class="flex items-center space-x-2.5">
              <div class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span>Manajemen Master Layanan & Prefix Kode</span>
            </div>
            <div class="flex items-center space-x-2.5">
              <div class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span>Pemetaan Multi-Layanan ke Loket Fisik (M:N)</span>
            </div>
            <div class="flex items-center space-x-2.5">
              <div class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span>Pengaturan Display TV & Trigger Reset Harian</span>
            </div>
          </div>
        </div>

        <!-- Left Footer -->
        <div class="relative z-10 pt-6 border-t border-white/10 flex items-center justify-between text-[11px] text-slate-400">
          <span>&copy; AntriAja Cloud SaaS</span>
          <span class="flex items-center gap-1.5 font-mono text-amber-300">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            Admin RBAC Guarded
          </span>
        </div>
      </div>

      <!-- Right Form Panel -->
      <div class="lg:col-span-7 p-6 sm:p-10 flex flex-col justify-between bg-white">
        <div>
          <!-- Top Navigation Header: Back Link & Role Switcher -->
          <div class="flex items-center justify-between gap-2 mb-6">
            <a href="/" class="inline-flex items-center text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
              <span>Beranda</span>
            </a>

            <!-- Segmented Role Switcher Tab -->
            <div class="inline-flex p-1 rounded-xl bg-slate-100 border border-slate-200 text-xs font-semibold">
              <a href="/staff/login" class="px-3 py-1 rounded-lg text-slate-500 hover:text-slate-900 transition-colors">
                Petugas Loket
              </a>
              <span class="px-3 py-1 rounded-lg bg-slate-900 text-white shadow-2xs font-bold">
                Administrator
              </span>
            </div>
          </div>

          <!-- Title & Subtitle -->
          <div class="mb-6">
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
              Login Administrator
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              Kelola master layanan, alokasi loket, dan konfigurasi display TV
            </p>
          </div>

          <!-- Quick Fill Demo Credentials Helper -->
          <button
            id="btn-quick-fill-demo"
            type="button"
            class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-amber-50 hover:bg-amber-100/80 text-amber-900 border border-amber-200 text-xs font-bold transition-all cursor-pointer mb-5 shadow-2xs"
            title="Klik untuk mengisi data login akun demo admin secara instan"
          >
            <span class="flex items-center gap-1.5">
              <span class="text-sm">⚡</span>
              <span>Gunakan Akun Demo Admin</span>
            </span>
            <span class="text-[11px] font-mono font-medium bg-white px-2 py-0.5 rounded-md border border-amber-200 text-amber-950">
              demo-bank &bull; admin
            </span>
          </button>

          <!-- Error Alert Container -->
          <div id="admin-login-error" class="hidden mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700 font-medium flex items-center gap-2">
            <svg class="w-4 h-4 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span id="admin-login-error-text"></span>
          </div>

          <!-- Login Form -->
          <form id="admin-login-form" class="space-y-4">
            <!-- Tenant Slug -->
            <div>
              <label for="input-tenant-slug" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Kode / Slug Instansi <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                </div>
                <input
                  id="input-tenant-slug"
                  name="tenant_slug"
                  type="text"
                  required
                  placeholder="misal: demo-bank"
                  class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:bg-white transition-all font-mono font-medium"
                />
              </div>
            </div>

            <!-- Email -->
            <div>
              <label for="input-email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Email Administrator <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/></svg>
                </div>
                <input
                  id="input-email"
                  name="email"
                  type="email"
                  required
                  placeholder="admin@antriaja.com"
                  class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:bg-white transition-all"
                />
              </div>
            </div>

            <!-- Password -->
            <div>
              <label for="input-password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Kata Sandi <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                </div>
                <input
                  id="input-password"
                  name="password"
                  type="password"
                  required
                  placeholder="Minimal 8 karakter"
                  class="w-full pl-10 pr-10 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:bg-white transition-all"
                />
                <!-- Eye Toggle -->
                <button
                  id="btn-toggle-password"
                  type="button"
                  class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 transition-colors cursor-pointer"
                  title="Tampilkan / Sembunyikan Sandi"
                >
                  <svg id="eye-icon-show" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                  <svg id="eye-icon-hide" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>
                </button>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="pt-2">
              <button
                id="btn-admin-login-submit"
                type="submit"
                class="w-full flex items-center justify-center py-3 px-4 rounded-xl text-sm font-bold text-white bg-slate-900 hover:bg-slate-800 shadow-md shadow-slate-900/20 hover:shadow-lg transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-900 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
              >
                <span id="btn-admin-login-text">Masuk Sebagai Administrator</span>
                <svg id="btn-admin-login-spinner" class="hidden w-4 h-4 ml-2 animate-spin text-white" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>
            </div>
          </form>
        </div>

        <!-- Footer Help Text -->
        <div class="mt-6 pt-4 border-t border-slate-100 text-center text-xs text-slate-400">
          Akses khusus pejabat administrator cabang dengan hak kuasa penuh.
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { login } from '../../services/authService';
  import { setToken, setTenantSlug, setUser, getTenantSlug } from '../../lib/storage';

  function initAdminLoginPage() {
    const form = document.getElementById('admin-login-form') as HTMLFormElement | null;
    const slugInput = document.getElementById('input-tenant-slug') as HTMLInputElement | null;
    const emailInput = document.getElementById('input-email') as HTMLInputElement | null;
    const passwordInput = document.getElementById('input-password') as HTMLInputElement | null;
    const submitBtn = document.getElementById('btn-admin-login-submit') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-admin-login-text');
    const btnSpinner = document.getElementById('btn-admin-login-spinner');
    const errorAlert = document.getElementById('admin-login-error');
    const errorText = document.getElementById('admin-login-error-text');
    const btnQuickDemo = document.getElementById('btn-quick-fill-demo');
    const btnTogglePassword = document.getElementById('btn-toggle-password');
    const eyeShow = document.getElementById('eye-icon-show');
    const eyeHide = document.getElementById('eye-icon-hide');

    if (!form || !slugInput || !emailInput || !passwordInput || !submitBtn) return;

    // Pre-fill slug from URL query or localStorage
    const urlParams = new URLSearchParams(window.location.search);
    const querySlug = urlParams.get('slug') || getTenantSlug();
    if (querySlug) {
      slugInput.value = querySlug;
    }

    // 1-Click Quick Fill Demo Credentials for Admin
    btnQuickDemo?.addEventListener('click', () => {
      slugInput.value = 'demo-bank';
      emailInput.value = 'admin@antriaja.com';
      passwordInput.value = 'password123';
      if (errorAlert) errorAlert.classList.add('hidden');
      emailInput.focus();
    });

    // Password Toggle Visibility
    btnTogglePassword?.addEventListener('click', () => {
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      eyeShow?.classList.toggle('hidden', isPassword);
      eyeHide?.classList.toggle('hidden', !isPassword);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorAlert) {
        errorAlert.classList.add('hidden');
      }

      const tenant_slug = slugInput.value.trim();
      const email = emailInput.value.trim();
      const password = passwordInput.value;

      if (!tenant_slug || !email || !password) {
        if (errorAlert && errorText) {
          errorText.textContent = 'Harap lengkapi seluruh kolom isian.';
          errorAlert.classList.remove('hidden');
        }
        return;
      }

      submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Memverifikasi...';
      if (btnSpinner) btnSpinner.classList.remove('hidden');

      try {
        const res = await login({ tenant_slug, email, password });

        if (!res.success || !res.data) {
          const errorMsg = res.error?.message || 'Login gagal. Periksa kembali email dan kata sandi Anda.';
          if (errorAlert && errorText) {
            errorText.textContent = errorMsg;
            errorAlert.classList.remove('hidden');
          }
          return;
        }

        // RBAC Enforcement: Role must be admin
        if (res.data.user.role !== 'admin') {
          if (errorAlert && errorText) {
            errorText.textContent = 'Akses ditolak: Akun ini bukan administrator cabang.';
            errorAlert.classList.remove('hidden');
          }
          return;
        }

        // Save session credentials
        setToken(res.data.token);
        setTenantSlug(res.data.tenant.slug);
        setUser(res.data.user);

        // Redirect to admin dashboard
        window.location.href = '/admin';
      } catch (err: unknown) {
        if (errorAlert && errorText) {
          errorText.textContent = 'Terjadi gangguan jaringan saat menghubungi server.';
          errorAlert.classList.remove('hidden');
        }
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Masuk Sebagai Administrator';
        if (btnSpinner) btnSpinner.classList.add('hidden');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdminLoginPage);
  } else {
    initAdminLoginPage();
  }
</script>
