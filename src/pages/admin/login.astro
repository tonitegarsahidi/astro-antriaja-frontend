---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Login Administrator - AntriAja" description="Masuk ke Panel Administrasi Cabang AntriAja">
  <div class="min-h-screen bg-slate-100 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
      <!-- Logo -->
      <a href="/" class="inline-flex items-center space-x-2 text-blue-600 font-black text-2xl tracking-tight mb-4">
        <svg class="w-9 h-9" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M17 20H7C4.79086 20 3 18.2091 3 16V8C3 5.79086 4.79086 4 7 4H17C19.2091 4 21 5.79086 21 8V16C21 18.2091 19.2091 20 17 20Z" stroke="currentColor" stroke-width="2"/>
          <path d="M7 10L10 13L17 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>AntriAja</span>
      </a>

      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 mb-2">
        Akses Khusus Administrator Cabang
      </span>

      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Login Administrator
      </h2>
      <p class="mt-2 text-sm text-slate-600">
        Kelola master layanan, alokasi loket, dan konfigurasi display TV
      </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md px-4 sm:px-0">
      <div class="bg-white py-8 px-6 shadow-sm sm:rounded-2xl border border-slate-200 sm:px-10">
        <!-- Error Alert Container -->
        <div id="admin-login-error" class="hidden mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-sm text-rose-700 font-medium"></div>

        <form id="admin-login-form" class="space-y-5">
          <!-- Tenant Slug -->
          <div>
            <label for="input-tenant-slug" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Kode / Slug Instansi <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <input
                id="input-tenant-slug"
                name="tenant_slug"
                type="text"
                required
                placeholder="misal: demo-bank"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all font-mono"
              />
            </div>
            <p class="mt-1 text-[11px] text-slate-400">Slug instansi yang diberikan saat registrasi tenant.</p>
          </div>

          <!-- Email -->
          <div>
            <label for="input-email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Email Administrator <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <input
                id="input-email"
                name="email"
                type="email"
                required
                placeholder="admin@instansi.com"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all"
              />
            </div>
          </div>

          <!-- Password -->
          <div>
            <label for="input-password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Kata Sandi <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <input
                id="input-password"
                name="password"
                type="password"
                required
                placeholder="Minimal 8 karakter"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all"
              />
            </div>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              id="btn-admin-login-submit"
              type="submit"
              class="w-full flex items-center justify-center py-3 px-4 rounded-xl text-sm font-bold text-white bg-slate-900 hover:bg-slate-800 shadow-sm transition-all focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-slate-900 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="btn-admin-login-text">Masuk Sebagai Administrator</span>
              <svg id="btn-admin-login-spinner" class="hidden w-5 h-5 ml-2 animate-spin text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>
        </form>

        <div class="mt-6 text-center space-y-2">
          <a href="/staff/login" class="text-xs font-medium text-blue-600 hover:underline block">
            Bukan Administrator? Masuk ke Konsol Staf &rarr;
          </a>
          <a href="/" class="text-xs font-semibold text-slate-500 hover:text-slate-800 transition-colors block">
            &larr; Kembali ke Portal Utama
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { login } from '../../services/authService';
  import { setToken, setTenantSlug, setUser, getTenantSlug } from '../../lib/storage';

  function initAdminLoginPage() {
    const form = document.getElementById('admin-login-form') as HTMLFormElement | null;
    const slugInput = document.getElementById('input-tenant-slug') as HTMLInputElement | null;
    const emailInput = document.getElementById('input-email') as HTMLInputElement | null;
    const passwordInput = document.getElementById('input-password') as HTMLInputElement | null;
    const submitBtn = document.getElementById('btn-admin-login-submit') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-admin-login-text');
    const btnSpinner = document.getElementById('btn-admin-login-spinner');
    const errorAlert = document.getElementById('admin-login-error');

    if (!form || !slugInput || !emailInput || !passwordInput || !submitBtn) return;

    // Pre-fill slug from URL query or localStorage
    const urlParams = new URLSearchParams(window.location.search);
    const querySlug = urlParams.get('slug') || getTenantSlug();
    if (querySlug) {
      slugInput.value = querySlug;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorAlert) {
        errorAlert.classList.add('hidden');
        errorAlert.textContent = '';
      }

      const tenant_slug = slugInput.value.trim();
      const email = emailInput.value.trim();
      const password = passwordInput.value;

      if (!tenant_slug || !email || !password) {
        if (errorAlert) {
          errorAlert.textContent = 'Harap lengkapi seluruh kolom isian';
          errorAlert.classList.remove('hidden');
        }
        return;
      }

      submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Memverifikasi...';
      if (btnSpinner) btnSpinner.classList.remove('hidden');

      try {
        const res = await login({ tenant_slug, email, password });

        if (!res.success || !res.data) {
          const errorMsg = res.error?.message || 'Login gagal. Periksa kembali email dan password Anda.';
          if (errorAlert) {
            errorAlert.textContent = errorMsg;
            errorAlert.classList.remove('hidden');
          }
          return;
        }

        // RBAC Enforcement: Role must be admin
        if (res.data.user.role !== 'admin') {
          if (errorAlert) {
            errorAlert.textContent = 'Akses ditolak: Akun ini tidak memiliki hak akses Administrator Cabang.';
            errorAlert.classList.remove('hidden');
          }
          return;
        }

        // Save session credentials
        setToken(res.data.token);
        setTenantSlug(res.data.tenant.slug);
        setUser(res.data.user);

        // Redirect to admin dashboard
        window.location.href = '/admin';
      } catch (err: unknown) {
        if (errorAlert) {
          errorAlert.textContent = 'Terjadi gangguan jaringan saat menghubungi server.';
          errorAlert.classList.remove('hidden');
        }
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Masuk Sebagai Administrator';
        if (btnSpinner) btnSpinner.classList.add('hidden');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdminLoginPage);
  } else {
    initAdminLoginPage();
  }
</script>
